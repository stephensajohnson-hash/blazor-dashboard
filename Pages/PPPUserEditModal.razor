@using Dashboard
@using Dashboard.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<div class="fixed inset-0 bg-black/90 backdrop-blur-sm z-[1000] flex items-center justify-center p-4">
    <div class="bg-[#111] w-full max-w-4xl rounded-3xl border border-gray-800 shadow-[0_0_50px_rgba(0,0,0,0.8)] overflow-hidden animate-in zoom-in duration-200 flex flex-col max-h-[90vh]">
        
        <div class="p-6 bg-gray-900/50 border-b border-gray-800 flex justify-between items-center shrink-0">
            <h3 class="text-lg uppercase tracking-widest font-black text-blue-400">
                @(editingUser.Id == 0 ? "Register New User" : "Update Profile")
            </h3>
            <button @onclick="Close" class="text-gray-500 hover:text-white text-2xl font-light">&times;</button>
        </div>

        @if (isLoading)
        {
            <div class="p-20 flex flex-col items-center justify-center">
                <div class="w-10 h-10 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
                <div class="text-xs text-slate-500 font-black tracking-widest mt-4 uppercase">Loading Data...</div>
                
                @* DEBUG PANEL (LOADING STATE) *@
                <div class="mt-8 bg-yellow-500/10 border border-yellow-500/50 text-yellow-500 p-4 rounded-xl font-mono text-xs text-left w-full max-w-md">
                    <b>[DEBUGGING - LOADING]</b><br/>
                    Expected UserId Parameter: @UserId <br/>
                    Currently Locked UserId: @_loadedUserId
                </div>
            </div>
        }
        else
        {
            <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-10 overflow-y-auto">
                
                @* DEBUG PANEL (LOADED STATE) - Visible to help us track this down *@
                <div class="col-span-1 md:col-span-2 bg-yellow-500/10 border border-yellow-500/50 text-yellow-500 p-4 rounded-xl font-mono text-xs text-left w-full">
                    <b>[DEBUGGING - DATA LOADED]</b><br/>
                    Passed Parameter UserId: @UserId <br/>
                    Internal Locked UserId: @_loadedUserId <br/>
                    EditingUser.Id: @editingUser.Id <br/>
                    EditingUser.Email: @(string.IsNullOrEmpty(editingUser.Email) ? "NULL/EMPTY" : editingUser.Email) <br/>
                    EditingUser.FirstName: @(string.IsNullOrEmpty(editingUser.FirstName) ? "NULL/EMPTY" : editingUser.FirstName) <br/>
                    Address Count: @(editingUser.Addresses?.Count ?? 0)
                </div>

                @* LEFT COLUMN: Account Details *@
                <div class="space-y-6">
                    <h4 class="text-[10px] uppercase tracking-[0.2em] text-blue-500 font-black mb-4">Account Security</h4>
                    
                    <div class="flex items-center gap-6 bg-black/30 p-4 rounded-2xl border border-gray-800">
                        @if (editingUser.AvatarId.HasValue)
                        {
                            <img src="/db-images-ppp/@editingUser.AvatarId" class="w-20 h-20 rounded-2xl object-cover border-2 border-blue-500/50" />
                        }
                        else
                        {
                            <div class="w-20 h-20 rounded-2xl bg-gray-900 border-2 border-dashed border-gray-700 flex items-center justify-center text-2xl">👤</div>
                        }
                        <div class="flex-1">
                            <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">Profile Image</label>
                            <InputFile OnChange="HandleImageUpload" class="text-xs text-gray-400 file:bg-blue-600 file:text-white file:border-0 file:px-3 file:py-1 file:rounded-lg file:mr-4 file:font-black file:uppercase file:text-[9px] cursor-pointer" />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">First Name</label>
                            <input @bind="editingUser.FirstName" class="w-full bg-black border border-gray-800 rounded-xl p-3 text-sm focus:border-blue-500 outline-none transition font-black uppercase text-white" />
                        </div>
                        <div>
                            <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">Last Name</label>
                            <input @bind="editingUser.LastName" class="w-full bg-black border border-gray-800 rounded-xl p-3 text-sm focus:border-blue-500 outline-none transition font-black uppercase text-white" />
                        </div>
                    </div>

                    <div>
                        <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">Email / Username</label>
                        <input @bind="editingUser.Email" disabled class="w-full bg-black/50 border border-gray-800 rounded-xl p-3 text-sm text-gray-500 outline-none font-mono" />
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">Phone</label>
                            <input @bind="editingUser.Phone" placeholder="903-555-1212" class="w-full bg-black border border-gray-800 rounded-xl p-3 text-sm focus:border-blue-500 outline-none transition font-mono text-white" />
                        </div>
                        <div>
                            <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">Access Role</label>
                            <select @bind="editingUser.Role" class="w-full bg-black border border-gray-800 rounded-xl p-3 text-sm focus:border-blue-500 outline-none transition font-black uppercase text-white">
                                <option value="Customer">Customer</option>
                                <option value="Staff">Staff</option>
                                <option value="Owner">Owner</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                    </div>
                </div>

                @* RIGHT COLUMN: Address Maintenance *@
                <div class="space-y-6">
                    <div class="flex justify-between items-end">
                        <h4 class="text-[10px] uppercase tracking-[0.2em] text-emerald-500 font-black">Address Registry</h4>
                        <button @onclick="AddNewAddress" class="text-[9px] font-black uppercase text-emerald-500 hover:text-white transition">＋ New Address</button>
                    </div>

                    <div class="space-y-4">
                        @if (editingUser.Addresses == null || !editingUser.Addresses.Any())
                        {
                            <div class="py-10 text-center border-2 border-dashed border-gray-800 rounded-3xl text-gray-600 uppercase text-[9px] font-black">
                                No physical addresses registered.
                            </div>
                        }
                        else
                        {
                            @foreach (var addr in editingUser.Addresses)
                            {
                                var localAddr = addr; 
                                var borderClass = localAddr.IsDefault ? "border-emerald-500/50" : "border-gray-800";
                                <div class="bg-black/30 border @borderClass p-5 rounded-2xl relative group/addr transition-all">
                                    <div class="flex justify-between items-start mb-3">
                                        <div class="flex items-center gap-2">
                                            <input @bind="localAddr.Label" placeholder="Label (Home, Office...)" class="bg-transparent border-none text-[10px] font-black uppercase text-white outline-none focus:ring-0 p-0 w-32" />
                                            @if (localAddr.IsDefault) { <span class="bg-emerald-500 text-black text-[7px] px-1.5 py-0.5 rounded-full font-black">PRIMARY</span> }
                                        </div>
                                        <div class="flex items-center gap-2 opacity-0 group-hover/addr:opacity-100 transition-opacity">
                                            @if (!localAddr.IsDefault) { <button @onclick="() => SetPrimary(localAddr)" class="text-[8px] font-black text-gray-500 hover:text-emerald-500 uppercase transition-colors">Set Primary</button> }
                                            <button @onclick="() => RemoveAddress(localAddr)" class="text-rose-500 text-xs hover:scale-110 transition-transform">✕</button>
                                        </div>
                                    </div>
                                    <div class="space-y-2">
                                        <input @bind="localAddr.Street" placeholder="Street Address" class="w-full bg-black/50 border border-gray-800 rounded-lg p-2 text-xs text-slate-300 outline-none focus:border-blue-500 transition-colors" />
                                        <div class="grid grid-cols-3 gap-2">
                                            <input @bind="localAddr.City" placeholder="City" class="bg-black/50 border border-gray-800 rounded-lg p-2 text-xs text-slate-300 outline-none focus:border-blue-500 transition-colors" />
                                            <input @bind="localAddr.State" placeholder="ST" maxlength="2" class="bg-black/50 border border-gray-800 rounded-lg p-2 text-xs text-slate-300 outline-none focus:border-blue-500 text-center uppercase transition-colors" />
                                            <input @bind="localAddr.ZipCode" placeholder="Zip" class="bg-black/50 border border-gray-800 rounded-lg p-2 text-xs text-slate-300 outline-none focus:border-blue-500 font-mono transition-colors" />
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="p-6 bg-gray-900/50 border-t border-gray-800 flex justify-end gap-4 shrink-0">
                <button @onclick="Close" class="text-[10px] text-gray-500 uppercase tracking-widest font-black px-6">Cancel</button>
                <button @onclick="HandleSave" class="bg-blue-600 hover:bg-blue-500 text-white text-[10px] uppercase tracking-widest font-black px-8 py-3 rounded-xl shadow-lg transition">Commit Changes</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public int UserId { get; set; }

    private PPP_User editingUser = new();
    private bool isLoading = true;
    private int _loadedUserId = -1; // Lock variable to stop infinite re-renders

    protected override async Task OnParametersSetAsync()
    {
        Console.WriteLine($"[MODAL DEBUG] OnParametersSetAsync fired. Parameter UserId: {UserId} | Currently locked UserId: {_loadedUserId}");

        // Only load if the ID passed in is different from what we already have loaded.
        if (UserId != _loadedUserId)
        {
            _loadedUserId = UserId; // Immediately lock it
            await LoadDataSafely();
        }
    }

    private async Task LoadDataSafely()
    {
        Console.WriteLine($"[MODAL DEBUG] LoadDataSafely started for UserId: {UserId}");
        isLoading = true;
        StateHasChanged(); // Force the UI to show the spinner

        try 
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            if (UserId == 0)
            {
                Console.WriteLine("[MODAL DEBUG] UserId is 0. Creating brand new blank user.");
                editingUser = new PPP_User { CreatedAt = DateTime.UtcNow, Role = "Customer", Addresses = new List<PPP_Address>() };
            }
            else
            {
                Console.WriteLine($"[MODAL DEBUG] Querying database for UserId: {UserId}...");
                var dbUser = await db.PPP_Users
                    .AsNoTracking()
                    .Include(u => u.Addresses)
                    .FirstOrDefaultAsync(u => u.Id == UserId);
                    
                if (dbUser != null)
                {
                    Console.WriteLine($"[MODAL DEBUG] User found in DB! Email: {dbUser.Email}, Addresses Count: {dbUser.Addresses?.Count ?? 0}");
                    
                    // Map to a pure POCO
                    editingUser = new PPP_User
                    {
                        Id = dbUser.Id,
                        FirstName = dbUser.FirstName,
                        LastName = dbUser.LastName,
                        Email = dbUser.Email,
                        Phone = dbUser.Phone,
                        Role = dbUser.Role,
                        AvatarId = dbUser.AvatarId,
                        CreatedAt = dbUser.CreatedAt,
                        Addresses = dbUser.Addresses?.Select(a => new PPP_Address
                        {
                            Id = a.Id, Street = a.Street, City = a.City, State = a.State, ZipCode = a.ZipCode,
                            Label = a.Label, IsDefault = a.IsDefault, UserId = a.UserId
                        }).ToList() ?? new List<PPP_Address>()
                    };

                    Console.WriteLine($"[MODAL DEBUG] Mapping successful. EditingUser.Email is now: {editingUser.Email}");
                }
                else
                {
                    Console.WriteLine($"[MODAL DEBUG] ERROR! User with ID {UserId} was not found in the database!");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MODAL DEBUG] EXCEPTION CAUGHT: {ex.Message}");
            await JS.InvokeVoidAsync("console.error", "Load error: " + ex.Message);
        }
        finally
        {
            Console.WriteLine("[MODAL DEBUG] LoadDataSafely finished. Setting isLoading to false.");
            isLoading = false;
            StateHasChanged(); // Force the UI to redraw with the loaded data
        }
    }

    private void AddNewAddress() 
    {
        if (editingUser.Addresses == null) editingUser.Addresses = new List<PPP_Address>();
        bool isFirst = editingUser.Addresses.Count == 0;
        editingUser.Addresses.Add(new PPP_Address { Label = "Home", IsDefault = isFirst, UserId = editingUser.Id });
    }

    private void RemoveAddress(PPP_Address addr)
    {
        if (editingUser.Addresses != null) editingUser.Addresses.Remove(addr);
    }

    private void SetPrimary(PPP_Address target) 
    { 
        if (editingUser.Addresses != null)
        {
            foreach(var a in editingUser.Addresses) a.IsDefault = false; 
        }
        target.IsDefault = true; 
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        try {
            var file = e.File;
            if (file == null) return;
            await using var db = await DbFactory.CreateDbContextAsync();
            using var ms = new System.IO.MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 2).CopyToAsync(ms);
            var newImage = new PPP_StoredImage { Data = ms.ToArray(), ContentType = file.ContentType, FileName = file.Name, UploadedAt = DateTime.UtcNow };
            db.PPP_StoredImages.Add(newImage);
            await db.SaveChangesAsync();
            editingUser.AvatarId = newImage.Id;
        } catch (Exception ex) {
            Console.WriteLine($"[MODAL DEBUG] Image upload failed: {ex.Message}");
            await JS.InvokeVoidAsync("console.error", "Image upload failed: " + ex.Message);
        }
    }

    private async Task HandleSave()
    {
        Console.WriteLine("[MODAL DEBUG] HandleSave triggered.");
        try {
            if (!string.IsNullOrEmpty(editingUser.Phone))
            {
                editingUser.Phone = PPPUtils.FormatPhoneNumber(editingUser.Phone);
            }

            if (string.IsNullOrWhiteSpace(editingUser.FirstName) || string.IsNullOrWhiteSpace(editingUser.Email))
            {
                await JS.InvokeVoidAsync("alert", "Name and Email are required");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            
            if (editingUser.Id == 0)
            {
                if (string.IsNullOrEmpty(editingUser.Role)) editingUser.Role = "Customer";
                db.PPP_Users.Add(editingUser);
            }
            else
            {
                var dbUser = await db.PPP_Users.Include(u => u.Addresses).FirstOrDefaultAsync(u => u.Id == editingUser.Id);
                if (dbUser == null) return;

                dbUser.FirstName = editingUser.FirstName;
                dbUser.LastName = editingUser.LastName;
                dbUser.Phone = editingUser.Phone;
                dbUser.Role = editingUser.Role;
                dbUser.AvatarId = editingUser.AvatarId;

                if (editingUser.Addresses != null)
                {
                    var incomingIds = new List<int>();
                    foreach (var a in editingUser.Addresses) incomingIds.Add(a.Id);

                    var currentAddresses = dbUser.Addresses.ToList();
                    foreach (var current in currentAddresses)
                    {
                        if (current.Id != 0 && !incomingIds.Contains(current.Id))
                        {
                            dbUser.Addresses.Remove(current);
                        }
                    }
                    
                    foreach (var inc in editingUser.Addresses) {
                        var ex = dbUser.Addresses.FirstOrDefault(a => a.Id == inc.Id && a.Id != 0);
                        if (ex != null) { 
                            ex.Street = inc.Street; ex.City = inc.City; ex.State = inc.State; 
                            ex.ZipCode = inc.ZipCode; ex.Label = inc.Label; ex.IsDefault = inc.IsDefault; 
                        }
                        else { 
                            inc.UserId = dbUser.Id; 
                            dbUser.Addresses.Add(inc); 
                        }
                    }
                }
            }

            await db.SaveChangesAsync();
            Console.WriteLine("[MODAL DEBUG] Database Save changes completed successfully.");
            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        } catch (Exception ex) { 
            Console.WriteLine($"[MODAL DEBUG] Save Error: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Error saving: " + ex.Message); 
        }
    }
}