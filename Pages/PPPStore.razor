@page "/ppp-store/{OwnerId:int}"
@using Dashboard
@using Dashboard.Services
@using Dashboard.Components
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Timers
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PPPCartService CartService

<div class="min-h-screen w-full bg-[#050505] text-slate-200 font-sans antialiased">
    @if (owner != null)
    {
        @* STICKY HEADER *@
        <div class="sticky top-0 z-[100] bg-[#050505]/80 backdrop-blur-xl border-b border-white/10 px-8 py-6">
            <header class="flex flex-row justify-between items-center gap-6">
                <div>
                    <h1 class="text-4xl font-black uppercase italic tracking-tighter text-white">@owner.BusinessName</h1>
                    <p class="text-slate-400 uppercase tracking-widest text-sm mt-2 font-bold">Available Menu Schedule</p>
                </div>
                
                <div class="flex items-center gap-6 ml-auto">
                    @if (currentUser != null)
                    {
                        <div class="relative group">
                            <div class="flex items-center gap-4 bg-white/5 p-2 pr-6 rounded-full border border-white/10 cursor-pointer hover:bg-white/10 transition-all">
                                <div class="w-10 h-10 rounded-full overflow-hidden border border-white/10 shrink-0 bg-emerald-600 flex items-center justify-center font-black text-white">
                                    @if (currentUser.AvatarId.HasValue)
                                    {
                                        <img src="/db-images-ppp/@currentUser.AvatarId" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <span>@currentUser.FirstName?[0]@currentUser.LastName?[0]</span>
                                    }
                                </div>
                                <div class="flex flex-col leading-tight">
                                    <span class="text-sm font-black uppercase text-white">@currentUser.FirstName @currentUser.LastName</span>
                                    @if (isImpersonating)
                                    {
                                        <span class="text-[10px] font-black uppercase text-amber-500 animate-pulse">🕵️ Impersonating</span>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] font-black uppercase text-slate-500 font-bold">Customer</span>
                                    }
                                </div>
                            </div>

                            @* Avatar Dropdown Menu *@
                            <div class="absolute right-0 mt-2 w-64 bg-[#111] border border-white/10 rounded-2xl shadow-2xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-[110]">
                                <div class="px-4 py-3 border-b border-white/5 mb-2">
                                    <p class="text-[10px] font-black text-slate-500 uppercase">Logged in as</p>
                                    <p class="text-xs font-bold text-white truncate">@currentUser.Email</p>
                                </div>
                                
                                <button @onclick="() => showProfileModal = true" class="w-full text-left px-4 py-3 text-xs font-black uppercase text-slate-400 hover:bg-white/5 transition-colors flex items-center gap-3">
                                    <span>👤</span> Edit My Profile
                                </button>

                                @if (isImpersonating)
                                {
                                    <button @onclick="EndImpersonation" class="w-full text-left px-4 py-3 text-xs font-black uppercase text-rose-500 hover:bg-rose-500/10 transition-colors flex items-center gap-3">
                                        <span>🚫</span> Stop Impersonating
                                    </button>
                                }
                                <button class="w-full text-left px-4 py-3 text-xs font-black uppercase text-slate-400 hover:bg-white/5 transition-colors">
                                    Logout
                                </button>
                            </div>
                        </div>
                    }

                    <div @onclick='() => Nav.NavigateTo($"/ppp-cart/{OwnerId}")' 
                         class="bg-emerald-500/10 border border-emerald-500/20 px-6 py-3 rounded-2xl flex items-center gap-4 cursor-pointer hover:bg-emerald-500/20 transition-all">
                        <span class="text-2xl">🛒</span>
                        <div class="flex flex-col">
                            <span class="text-[10px] font-black uppercase text-emerald-500 tracking-widest font-bold">Your Cart</span>
                            <span class="text-sm font-bold text-white">@CartService.Items.Count Items</span>
                        </div>
                    </div>
                </div>
            </header>
        </div>

        <div class="p-8 max-w-4xl mx-auto space-y-12">
            @foreach (var dayGroup in activeMenus.SelectMany(m => m.Items).OrderBy(i => i.StartDate).GroupBy(i => i.StartDate.Date))
            {
                <section>
                    <h3 class="text-emerald-500 font-black uppercase tracking-[0.3em] text-base mb-6 flex items-center gap-4">
                        @dayGroup.Key.ToString("dddd, MMM d")
                        <span class="h-px flex-1 bg-white/5"></span>
                    </h3>

                    <div class="grid grid-cols-1 gap-8">
                        @foreach (var item in dayGroup)
                        {
                            var businessTimeNow = GetLocalTime(owner.TimeZoneId);
                            var cutoff = item.StartDate.Date.AddDays(-1).Add(item.CutoffTime.ToTimeSpan());
                            var timeRemaining = cutoff - businessTimeNow;
                            bool pastCutoff = businessTimeNow > cutoff;
                            bool showUrgencyBadge = !pastCutoff && timeRemaining.TotalHours < 24;

                            <div @onclick="() => NavigateToItem(item.Id)" 
                                 class="bg-[#111] border border-slate-800 p-8 rounded-[2.5rem] flex flex-col md:flex-row gap-8 transition-all @(pastCutoff ? "opacity-40 grayscale pointer-events-none" : "hover:border-emerald-500/50 cursor-pointer shadow-xl")">
                                
                                @if (item.Recipe?.ImageId != null)
                                {
                                    <div class="w-48 h-48 rounded-[2rem] overflow-hidden shrink-0 bg-black shadow-2xl border border-white/5">
                                        <img src="/db-images-ppp/@item.Recipe.ImageId" class="w-full h-full object-cover" />
                                    </div>
                                }

                                <div class="flex-1 flex flex-col justify-start">
                                    <div class="flex justify-between items-start mb-4">
                                        <h4 class="text-2xl font-black text-white uppercase italic tracking-tight">@item.Recipe?.Name</h4>
                                        @if (pastCutoff)
                                        {
                                            <span class="text-sm font-black uppercase bg-rose-500 text-white px-3 py-1 rounded-full">Ordering Closed</span>
                                        }
                                    </div>

                                    @if (showUrgencyBadge)
                                    {
                                        <div class="mb-6 p-4 bg-white/5 border border-white/10 rounded-2xl inline-flex flex-wrap items-center gap-3">
                                            <div class="flex flex-col text-sm">
                                                <span class="text-[10px] font-black text-slate-500 uppercase font-bold">Order Deadline</span>
                                                <span class="font-bold text-slate-300">@cutoff.ToString("ddd MMM d") @@ @cutoff.ToString("h:mm tt")</span>
                                            </div>
                                            <span class="h-8 w-px bg-white/10 hidden sm:block"></span>
                                            <div class="flex flex-col">
                                                <span class="text-[10px] font-black text-yellow-500 uppercase italic font-bold">Time Remaining</span>
                                                <span class="text-base font-mono font-black text-yellow-400 tabular-nums">
                                                    @($"{ (int)timeRemaining.TotalHours:D2}h {timeRemaining.Minutes:D2}m {timeRemaining.Seconds:D2}s")
                                                </span>
                                            </div>
                                        </div>
                                    }

                                    <p class="text-base text-slate-300 leading-relaxed mb-6 font-medium">@item.Recipe?.LongDescription</p>

                                    @if (owner.ShowIngredientsToCustomer && item.Recipe != null)
                                    {
                                        <div class="mb-6">
                                            <h5 class="text-[10px] font-black uppercase text-slate-500 tracking-[0.2em] mb-2 font-bold">Ingredients</h5>
                                            <p class="text-sm text-slate-400 italic">@GetIngredientList(item.Recipe)</p>
                                        </div>
                                    }

                                    @if (owner.ShowMacrosToCustomer)
                                    {
                                        <div class="mt-auto pt-6 border-t border-white/5 grid grid-cols-3 sm:grid-cols-6 gap-4">
                                            @{ var m = CalculateMacros(item.Recipe); }
                                            <div class="flex flex-col"><span class="text-[10px] font-black text-slate-500 uppercase mb-1 font-bold">Calories</span><span class="text-sm font-bold text-white">🔥 @m.Cals</span></div>
                                            <div class="flex flex-col"><span class="text-[10px] font-black text-slate-500 uppercase mb-1 font-bold">Protein</span><span class="text-sm font-bold text-blue-400">🥩 @m.Prot g</span></div>
                                            <div class="flex flex-col"><span class="text-[10px] font-black text-slate-500 uppercase mb-1 font-bold">Fat</span><span class="text-sm font-bold text-amber-500">🥑 @m.Fat g</span></div>
                                            <div class="flex flex-col"><span class="text-[10px] font-black text-slate-500 uppercase mb-1 font-bold">Carbs</span><span class="text-sm font-bold text-slate-300">🍞 @m.Carb g</span></div>
                                            <div class="flex flex-col"><span class="text-[10px] font-black text-slate-500 uppercase mb-1 font-bold">Fiber</span><span class="text-sm font-bold text-emerald-600">🌿 @m.Fib g</span></div>
                                            <div class="flex flex-col"><span class="text-[10px] font-black text-emerald-400 uppercase mb-1 font-black">Net Carbs</span><span class="text-sm font-black text-emerald-400">🥦 @m.Net g</span></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@if (showProfileModal && currentUser != null)
{
    <PPPUserEditModal User="currentUser" 
                      OnClose="() => showProfileModal = false" 
                      OnSaved="HandleProfileSaved" />
}

@code {
    [Parameter] public int OwnerId { get; set; }
    private PPP_Owner? owner;
    private List<PPP_Menu> activeMenus = new();
    private Timer? timer;

    private PPP_User? currentUser;
    private PPP_User? sessionUser;
    private bool isImpersonating = false;
    private bool showProfileModal = false;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            owner = await db.PPP_Owners.Include(o => o.Address).AsNoTracking().FirstOrDefaultAsync(o => o.Id == OwnerId);
            
            var today = DateTime.Today.ToUniversalTime();
            activeMenus = await db.Set<PPP_Menu>()
                .Include(m => m.Items).ThenInclude(i => i.Recipe).ThenInclude(r => r.IngredientGroups).ThenInclude(g => g.Ingredients).ThenInclude(ing => ing.Ingredient)
                .Include(m => m.Items).ThenInclude(i => i.Timeframes)
                .Include(m => m.Items).ThenInclude(i => i.Sizes)
                .Where(m => m.OwnerId == OwnerId && m.IsPublished && m.EndDate >= today)
                .AsNoTracking()
                .ToListAsync();

            timer = new Timer(1000);
            timer.Elapsed += async (s, e) => await InvokeAsync(StateHasChanged);
            timer.AutoReset = true;
            timer.Enabled = true;
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSessionIdentity();
            StateHasChanged();
        }
    }

    private async Task LoadSessionIdentity()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("eval", "(() => { try { var m = document.cookie.split('; ').find(row => row.startsWith('ppp_token=')); return m ? m.split('=')[1] : null; } catch(e) { return null; } })()");
            
            if (!string.IsNullOrEmpty(token))
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                
                sessionUser = await db.PPP_Users
                    .AsNoTracking() 
                    .Include(u => u.Addresses)
                    .FirstOrDefaultAsync(u => u.MagicToken == token && u.TokenExpiresAt > DateTime.UtcNow);
                
                if (sessionUser != null)
                {
                    if (!string.IsNullOrEmpty(sessionUser.ImpersonatingEmail))
                    {
                        currentUser = await db.PPP_Users
                            .AsNoTracking()
                            .Include(u => u.Addresses)
                            .FirstOrDefaultAsync(u => u.Email == sessionUser.ImpersonatingEmail);
                        isImpersonating = true;
                    }
                    else
                    {
                        currentUser = sessionUser;
                        isImpersonating = false;
                    }
                }
            }
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    private async Task HandleProfileSaved()
    {
        showProfileModal = false;
        await LoadSessionIdentity();
        StateHasChanged();
    }

    private async Task EndImpersonation()
    {
        if (sessionUser != null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbUser = await db.PPP_Users.FindAsync(sessionUser.Id);
            if (dbUser != null)
            {
                dbUser.ImpersonatingEmail = null;
                await db.SaveChangesAsync();
                Nav.NavigateTo(Nav.Uri, forceLoad: true);
            }
        }
    }

    private void NavigateToItem(int menuItemId) => Nav.NavigateTo($"/ppp-store/{OwnerId}/item/{menuItemId}");

    private DateTime GetLocalTime(string? timeZoneId)
    {
        try {
            var zoneId = string.IsNullOrEmpty(timeZoneId) ? "Central Standard Time" : timeZoneId;
            var tzi = TimeZoneInfo.FindSystemTimeZoneById(zoneId);
            return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tzi);
        } catch { return DateTime.Now; }
    }

    private string GetIngredientList(PPP_Recipe r)
    {
        if (r.IngredientGroups == null) return "";
        return string.Join(", ", r.IngredientGroups
            .SelectMany(g => g.Ingredients ?? new List<PPP_RecipeIngredientMapping>())
            .Where(m => m.Ingredient != null)
            .Select(m => m.Ingredient!.Name.ToLower().Trim())
            .Distinct());
    }

    private (double Cals, double Prot, double Fat, double Carb, double Fib, double Net) CalculateMacros(PPP_Recipe? r)
    {
        if (r == null || r.Servings <= 0 || r.IngredientGroups == null) return (0, 0, 0, 0, 0, 0);
        double cals = 0, prot = 0, fat = 0, carb = 0, fib = 0;
        foreach (var group in r.IngredientGroups)
        {
            foreach (var mapping in group.Ingredients ?? new List<PPP_RecipeIngredientMapping>())
            {
                if (mapping.Ingredient != null)
                {
                    cals += mapping.Ingredient.Calories * mapping.Quantity;
                    prot += mapping.Ingredient.Protein * mapping.Quantity;
                    fat += mapping.Ingredient.Fat * mapping.Quantity;
                    carb += mapping.Ingredient.Carbs * mapping.Quantity;
                    fib += mapping.Ingredient.Fiber * mapping.Quantity;
                }
            }
        }
        double nCals = Math.Round(cals / r.Servings, 0);
        double nProt = Math.Round(prot / r.Servings, 1);
        double nFat = Math.Round(fat / r.Servings, 1);
        double nCarb = Math.Round(carb / r.Servings, 1);
        double nFib = Math.Round(fib / r.Servings, 1);
        return (nCals, nProt, nFat, nCarb, nFib, Math.Max(0, Math.Round(nCarb - nFib, 1)));
    }

    public void Dispose()
    {
        timer?.Dispose();
        CartService.OnChange -= StateHasChanged;
    }
}