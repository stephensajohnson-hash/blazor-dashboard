@page "/ppp-store/{OwnerId:int}"
@using Dashboard
@using Dashboard.Services
@using Dashboard.Components
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject GeocodingService GeoService
@inject PPPStoreService StoreService

<div class="h-screen w-full bg-[#050505] text-slate-200 font-sans antialiased overflow-hidden flex flex-col">
    
    @* Notification Stack *@
    <div class="fixed top-6 right-6 z-[900] flex flex-col gap-3">
        @foreach (var toast in toasts)
        {
            <div class="p-4 rounded-2xl border shadow-2xl animate-in slide-in-from-right @(toast.IsError ? "bg-red-950 border-red-500" : "bg-emerald-950 border-emerald-500") backdrop-blur-md">
                <span class="text-[10px] font-black uppercase tracking-widest text-white">@toast.Message</span>
            </div>
        }
    </div>

    @* Menu Area *@
    <div class="flex-1 overflow-y-auto pb-40">
        @if (owner != null)
        {
            <PPPStoreHeader Owner="owner" />
            <div class="max-w-3xl mx-auto px-4 mt-12">
                @foreach (var menu in activeMenus)
                {
                    @foreach (var dayGroup in menu.Items.OrderBy(i => i.StartDate).GroupBy(i => i.StartDate.Date))
                    {
                        <div class="mb-12">
                            <h3 class="text-[10px] font-black uppercase tracking-[0.4em] text-slate-500 mb-6 flex items-center gap-4">
                                @dayGroup.Key.ToString("dddd, MMM d") 
                                <span class="h-[1px] flex-1 bg-white/5"></span>
                            </h3>

                            <div class="grid grid-cols-1 gap-4">
                                @foreach (var item in dayGroup)
                                {
                                    bool pastCutoff = IsPastCutoff(item);
                                    <div @onclick="() => SelectItem(item)" class="bg-[#111] border border-slate-800 rounded-[2.5rem] overflow-hidden flex flex-col md:flex-row cursor-pointer group @(pastCutoff ? "opacity-50 grayscale pointer-events-none" : "hover:border-emerald-500/40")">
                                        @if (item.Recipe?.ImageId != null)
                                        {
                                            <div class="w-full md:w-44 aspect-square bg-black shrink-0">
                                                <img src="/db-images-ppp/@item.Recipe.ImageId" class="w-full h-full object-cover group-hover:scale-105" />
                                            </div>
                                        }
                                        <div class="p-6 flex-1 flex flex-col">
                                            <h4 class="text-xl font-black text-white uppercase italic tracking-tight">@item.Recipe?.Name</h4>
                                            <p class="text-xs text-slate-300 line-clamp-3 mb-2">@item.Recipe?.LongDescription</p>
                                            <div class="mt-auto pt-4 border-t border-white/5 flex flex-wrap gap-2 items-center">
                                                @{ var m = StoreService.GetMacros(item.Recipe); }
                                                <span class="bg-white/5 px-2 py-1 rounded-lg text-[10px] font-bold">🔥 @m.Cals cal</span>
                                                <span class="bg-blue-500/10 text-blue-400 px-2 py-1 rounded-lg text-[10px] font-bold">🥩 @m.Prot pro</span>
                                                <span class="bg-emerald-500/10 text-emerald-400 px-2 py-1 rounded-lg text-[10px] font-bold">🥦 @m.Net net</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>

    @* Persistent Cart Floating Bar *@
    @if (cart != null && cart.Items != null && cart.Items.Any())
    {
        <div class="fixed bottom-8 left-1/2 -translate-x-1/2 z-[150] w-full max-w-lg px-4">
            <button @onclick="OpenCart" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white p-6 rounded-[2rem] flex justify-between items-center shadow-2xl active:scale-95 border border-emerald-400/20">
                <div class="flex items-center gap-4">
                    <span class="bg-white/20 px-3 py-1 rounded-lg font-black text-xs">@cart.Items.Count</span>
                    <span class="text-xs font-black uppercase tracking-widest">Review & Checkout</span>
                </div>
                <span class="font-mono font-bold">$@GetCartTotal().ToString("N2")</span>
            </button>
        </div>
    }

    @* Cart Overlay *@
    @if (showCart && cart != null)
    {
        <div class="fixed inset-0 bg-black/95 backdrop-blur-md z-[600] flex items-end justify-center" @onmousedown="SaveCartNotes">
            <div @onmousedown:stopPropagation="true" class="bg-[#0f0f0f] w-full max-w-2xl rounded-t-[3rem] border-t border-slate-800 p-10 shadow-2xl animate-in slide-in-from-bottom duration-300 max-h-[92vh] flex flex-col">
                <div class="flex justify-between items-start mb-8 shrink-0">
                    <h2 class="text-3xl font-black text-white uppercase italic tracking-tighter">Your Cart</h2>
                    <button @onclick="SaveCartNotes" class="bg-white/5 w-12 h-12 rounded-2xl text-slate-400 text-2xl transition-all">&times;</button>
                </div>
                <div class="flex-1 overflow-y-auto space-y-4 pr-2">
                    @foreach (var item in cart.Items.OrderBy(i => i.ScheduledDate))
                    {
                        <div class="bg-white/5 border border-white/5 rounded-3xl p-6 relative group">
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-[9px] font-black text-emerald-500 uppercase">@item.ScheduledDate.ToString("ddd, MMM d") — @item.TimeframeName</span>
                                <button @onclick="() => RemoveFromCart(item.Id)" class="text-slate-600 hover:text-red-500 text-xs">✕</button>
                            </div>
                            <h4 class="text-lg font-black text-white uppercase italic">@item.RecipeName</h4>
                            <div class="mt-2 flex gap-2 items-center opacity-60">
                                <span class="text-[10px]">@(item.FulfillmentMethod == "Delivery" ? "🚚" : "🏢")</span>
                                <span class="text-[8px] font-black uppercase tracking-widest">
                                    @(item.FulfillmentMethod == "Delivery" ? item.DeliveryAddressSummary : GetPickupLocationName(item.PickupLocationId))
                                </span>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-8 pt-8 border-t border-white/10 shrink-0">
                    <div class="flex justify-between items-end mb-8">
                        <span class="text-[10px] font-black uppercase text-slate-500">Order Total</span>
                        <span class="text-3xl font-black text-white italic font-mono">$@GetCartTotal().ToString("N2")</span>
                    </div>
                    <button @onclick="ProcessCheckout" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-6 rounded-3xl font-black text-xs uppercase tracking-[0.5em] transition-all shadow-xl active:scale-95">Place Order</button>
                </div>
            </div>
        </div>
    }

    @* Selection Modal *@
    @if (selectedItem != null && currentSize != null)
    {
        <div class="fixed inset-0 bg-black/95 backdrop-blur-md z-[400] flex flex-col items-center justify-end" @onmousedown="() => selectedItem = null">
            <div @onmousedown:stopPropagation="true" class="bg-[#0f0f0f] w-full max-w-2xl rounded-t-[3rem] border-t border-slate-800 shadow-2xl animate-in slide-in-from-bottom duration-300 max-h-[95vh] flex flex-col relative">
                <div class="flex-1 overflow-y-auto px-10 space-y-10 py-10">
                    <section class="p-6 bg-white/[0.02] border border-white/5 rounded-[2rem] space-y-6 shadow-inner">
                        <div>
                            <h5 class="text-[10px] font-black uppercase text-slate-500 mb-4 tracking-widest">Arrival Window</h5>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var tf in selectedItem.Timeframes ?? new List<PPP_MenuItemTimeframe>())
                                {
                                    <button @onclick="() => selTimeframe = tf.Name" class="px-5 py-2.5 rounded-xl border text-[10px] font-black uppercase transition-all @(selTimeframe == tf.Name ? "bg-emerald-600 border-emerald-600 text-white" : "border-slate-800 text-slate-500")">@tf.Name</button>
                                }
                            </div>
                        </div>
                        <div>
                            <h5 class="text-[10px] font-black uppercase text-slate-500 mb-4 tracking-widest mt-6">Fulfillment Method</h5>
                            @if (owner!.OffersPickup && owner.OffersDelivery)
                            {
                                <div class="flex gap-2 mb-6 bg-black p-1 rounded-2xl border border-slate-800">
                                    <button @onclick='() => selFulfillment = "Pickup"' class="flex-1 py-3 rounded-xl text-[10px] font-black uppercase @(selFulfillment == "Pickup" ? "bg-white text-black shadow-lg" : "text-slate-500")">Pickup</button>
                                    <button @onclick='() => selFulfillment = "Delivery"' class="flex-1 py-3 rounded-xl text-[10px] font-black uppercase @(selFulfillment == "Delivery" ? "bg-blue-600 text-white shadow-lg" : "text-slate-500")">Delivery</button>
                                </div>
                            }
                            @if (selFulfillment == "Delivery")
                            {
                                <div class="bg-black/40 border border-white/5 rounded-2xl p-4 space-y-3">
                                    <input @bind="tempAddress.Street" @onblur="UpdateCustomerCoords" placeholder="Street Address" class="w-full bg-[#0a0a0a] border border-slate-800 rounded-xl p-4 text-sm text-white" />
                                    <div class="grid grid-cols-3 gap-3">
                                        <input @bind="tempAddress.City" placeholder="City" class="bg-[#0a0a0a] border border-slate-800 rounded-xl p-4 text-xs text-white" />
                                        <input @bind="tempAddress.State" maxlength="2" placeholder="ST" class="bg-[#0a0a0a] border border-slate-800 rounded-xl p-4 text-xs text-white text-center" />
                                        <input @bind="tempAddress.ZipCode" @oninput="HandleFeeZipInput" maxlength="5" placeholder="Zip" class="bg-[#0a0a0a] border border-slate-800 rounded-xl p-4 text-xs text-white" />
                                    </div>
                                    @{ var feeInfo = GetDeliveryFeeInfo(tempAddress.ZipCode); }
                                    @if (feeInfo.Fee > 0)
                                    {
                                        <div class="bg-blue-600 text-white px-6 py-4 rounded-3xl flex justify-between items-center"><span class="text-xs font-black uppercase">@feeInfo.Label</span><span class="text-2xl font-black font-mono">$@feeInfo.Fee.ToString("N2")</span></div>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                    <section class="animate-in slide-in-from-top duration-500">
                        <h5 class="text-[10px] font-black uppercase text-emerald-500 mb-6 tracking-widest text-center italic">Personalize Your @currentSize.ServingsPerUnit Servings</h5>
                        @for (int i = 0; i < currentSize.ServingsPerUnit; i++)
                        {
                            var index = i;
                            <div class="bg-black border border-slate-800 rounded-[2rem] p-6 shadow-inner mb-4">
                                <input @bind="tempServingConfigs[index].LabelName" placeholder="Recipient Name" class="w-full bg-[#0a0a0a] border border-slate-800 rounded-xl p-4 text-sm text-white font-bold italic" />
                            </div>
                        }
                    </section>
                </div>
                <div class="p-10 shrink-0 border-t border-white/5 bg-[#0f0f0f] z-[500]">
                    <button @onclick="AddToCart" disabled="@(!IsConfigValid())" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-6 rounded-3xl font-black text-xs uppercase tracking-[0.4em] transition-all shadow-xl flex justify-between items-center px-10">
                        <span>Add Bundle to Cart</span>
                        <span class="font-mono">$@GetConfigTotal().ToString("N2")</span>
                    </button>
                </div>
            </div>
        </div>
    }

    @* Final Manifest *@
    @if (showContactForm)
    {
        <div class="fixed inset-0 bg-black/95 backdrop-blur-md z-[800] flex items-center justify-center p-4">
            <div class="bg-[#0f0f0f] w-full max-w-lg rounded-[3rem] border border-slate-800 p-10 shadow-2xl animate-in zoom-in-95 duration-200 flex flex-col max-h-[90vh]">
                <div class="flex justify-between items-start mb-6 shrink-0">
                    <div>
                        <h2 class="text-2xl font-black text-white uppercase italic tracking-tighter mb-2">Final Review</h2>
                        <p class="text-[10px] text-slate-500 font-black uppercase tracking-widest">Verify logistics manifest below</p>
                    </div>
                    <button @onclick="() => showContactForm = false" class="text-slate-600 hover:text-white text-2xl">&times;</button>
                </div>
                <div class="space-y-6 overflow-y-auto pr-2 flex-1">
                    <div class="grid grid-cols-2 gap-4">
                        <input @bind="tempUser.FirstName" placeholder="First Name" class="w-full bg-black border border-slate-800 rounded-xl p-4 text-sm text-white focus:border-emerald-500" />
                        <input @bind="tempUser.LastName" placeholder="Last Name" class="w-full bg-black border border-slate-800 rounded-xl p-4 text-sm text-white focus:border-emerald-500" />
                    </div>
                    <input @bind="tempUser.Email" type="email" placeholder="Email Address" class="w-full bg-black border border-slate-800 rounded-xl p-4 text-sm text-white focus:border-emerald-500" />
                    <input @bind="tempUser.Phone" type="tel" placeholder="Phone Number" class="w-full bg-black border border-slate-800 rounded-xl p-4 text-sm text-white focus:border-emerald-500" />
                    <div class="pt-6 border-t border-white/5 space-y-4">
                        <label class="text-[9px] font-black uppercase text-emerald-500 tracking-widest">Fulfillment Logistics</label>
                        <div class="space-y-3">
                            @foreach (var item in cart.Items.OrderBy(i => i.ScheduledDate))
                            {
                                <div class="bg-black/60 border border-white/5 rounded-2xl p-4 flex gap-4 items-center shadow-inner">
                                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-xs shrink-0">@if(item.FulfillmentMethod == "Delivery") { <span>🚚</span> } else { <span>🏢</span> }</div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-[9px] font-black text-emerald-500 uppercase truncate">@item.RecipeName</p>
                                        <p class="text-[10px] text-white font-bold truncate">@(item.FulfillmentMethod == "Delivery" ? item.DeliveryAddressSummary : GetPickupLocationName(item.PickupLocationId))</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="mt-10 pt-8 border-t border-white/5 flex gap-4 shrink-0">
                    <button @onclick="() => showContactForm = false" class="flex-1 bg-white/5 hover:bg-white/10 text-slate-500 py-5 rounded-3xl text-[10px] font-black uppercase tracking-widest transition-all">Back</button>
                    <button @onclick="FinalizeOrder" class="flex-[2] bg-emerald-600 hover:bg-emerald-500 text-white py-5 rounded-3xl text-[10px] font-black uppercase tracking-[0.3em] shadow-xl transition-all active:scale-95">Complete Order</button>
                </div>
            </div>
        </div>
    }
</div>