@page "/export-data"
@using Dashboard.Components.Bullet

<div class="min-h-screen bg-[#050505] text-white p-6 font-sans">
    <BulletHeader />

    <div class="max-w-6xl mx-auto mt-8">
        <h1 class="text-3xl font-black uppercase italic tracking-tighter text-emerald-400 mb-2">Data Export Hub</h1>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
            
            @* MEDIA EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl flex flex-col hover:border-emerald-500/50 transition-colors">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-emerald-500/20 flex items-center justify-center text-2xl">🎬</div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Media</h2>
                        <p class="text-[10px] font-mono text-gray-500">JSON Format</p>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mb-8 flex-1">
                    Exports all media tracking records, details, and associated notes.
                </p>
                <a href="/api/export/media" target="_top"
                   class="bg-emerald-600 hover:bg-emerald-500 text-white text-[10px] font-black uppercase tracking-widest px-4 py-4 rounded-xl transition text-center block">
                    DOWNLOAD JSON
                </a>
            </div>

            @* MEETING EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl flex flex-col hover:border-blue-500/50 transition-colors">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-blue-500/20 flex items-center justify-center text-2xl">🤝</div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Meetings</h2>
                        <p class="text-[10px] font-mono text-gray-500">JSON Format</p>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mb-8 flex-1">
                    Exports all meetings, durations, completion statuses, and associated notes.
                </p>
                <a href="/api/export/meetings" target="_top"
                   class="bg-blue-600 hover:bg-blue-500 text-white text-[10px] font-black uppercase tracking-widest px-4 py-4 rounded-xl transition text-center block">
                    DOWNLOAD JSON
                </a>
            </div>

            @* TASK EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl flex flex-col hover:border-purple-500/50 transition-colors">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-purple-500/20 flex items-center justify-center text-2xl">✅</div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Tasks</h2>
                        <p class="text-[10px] font-mono text-gray-500">JSON Format</p>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mb-8 flex-1">
                    Exports all tasks, priority levels, due dates, todo checklists, and notes.
                </p>
                <a href="/api/export/tasks" target="_top"
                   class="bg-purple-600 hover:bg-purple-500 text-white text-[10px] font-black uppercase tracking-widest px-4 py-4 rounded-xl transition text-center block">
                    DOWNLOAD JSON
                </a>
            </div>

            @* HABIT EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl flex flex-col hover:border-orange-500/50 transition-colors">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-orange-500/20 flex items-center justify-center text-2xl">🔁</div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Habits</h2>
                        <p class="text-[10px] font-mono text-gray-500">JSON Format</p>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mb-8 flex-1">
                    Exports all habits, active streaks, completion statuses, and notes.
                </p>
                <a href="/api/export/habits" target="_top"
                   class="bg-orange-600 hover:bg-orange-500 text-white text-[10px] font-black uppercase tracking-widest px-4 py-4 rounded-xl transition text-center block">
                    DOWNLOAD JSON
                </a>
            </div>

            @* EVENTS EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl flex flex-col hover:border-pink-500/50 transition-colors">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-pink-500/20 flex items-center justify-center text-2xl">🎈</div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Events</h2>
                        <p class="text-[10px] font-mono text-gray-500">JSON Format</p>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mb-8 flex-1">
                    Exports all holidays, birthdays, anniversaries, and vacation schedules.
                </p>
                <a href="/api/export/events" target="_top"
                   class="bg-pink-600 hover:bg-pink-500 text-white text-[10px] font-black uppercase tracking-widest px-4 py-4 rounded-xl transition text-center block">
                    DOWNLOAD JSON
                </a>
            </div>

            @* SPORTS EXPORT CARD (NEW) *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl flex flex-col hover:border-red-500/50 transition-colors">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-red-500/20 flex items-center justify-center text-2xl">⚾</div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Sports</h2>
                        <p class="text-[10px] font-mono text-gray-500">JSON Format</p>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mb-8 flex-1">
                    Exports all calendar games, scores, and associated league/team IDs.
                </p>
                <a href="/api/export/sports" target="_top"
                   class="bg-red-600 hover:bg-red-500 text-white text-[10px] font-black uppercase tracking-widest px-4 py-4 rounded-xl transition text-center block">
                    DOWNLOAD JSON
                </a>
            </div>

        </div>

        <p class="mt-8 text-[10px] text-gray-500 text-center uppercase tracking-widest">
            Direct API Routing / Bypasses SPA Interception
        </p>
    </div>
</div>