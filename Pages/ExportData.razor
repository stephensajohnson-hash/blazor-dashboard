@page "/export-data"
@using Dashboard
@using Dashboard.Components.Bullet
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<div class="min-h-screen bg-[#050505] text-white p-6 font-sans">
    <BulletHeader />

    <div class="max-w-5xl mx-auto mt-8">
        <h1 class="text-3xl font-black uppercase italic tracking-tighter text-emerald-400 mb-2">Data Export Hub</h1>
        <p class="text-slate-400 text-sm font-bold tracking-widest uppercase mb-8">Export Bullet Items (Flat Format)</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            @* MEDIA EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-6 flex flex-col gap-4 shadow-xl">
                <h2 class="text-lg font-black uppercase text-white">Media Export</h2>
                <button @onclick="() => ExportItemsByType(new[] { "" })" class="w-full bg-emerald-600 py-3 rounded-xl text-xs font-black uppercase">
                    Export Media Items
                </button>
            </div>

            @* TASKS EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-6 flex flex-col gap-4 shadow-xl">
                <h2 class="text-lg font-black uppercase text-white">Tasks Export</h2>
                <button @onclick="() => ExportItemsByType(new[] { "" })" class="w-full bg-blue-600 py-3 rounded-xl text-xs font-black uppercase">
                    Export Tasks
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private async Task ExportItemsByType(string[] types)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // 1. PROJECT: Select ONLY what we need to avoid circular references/bloat
            // We use .Include() to bring in the specific details based on the item type
            var items = await db.BulletItems
                .AsNoTracking()
                .Include(i => i.DbMediaDetail)
                .Include(i => i.DbTaskDetail)
                .Include(i => i.Notes)
                .Include(i => i.Todos)
                .OrderByDescending(i => i.Date)
                .ToListAsync();

            // 2. SERIALIZE: Use IgnoreCycles to be absolutely safe
            var options = new JsonSerializerOptions 
            { 
                WriteIndented = true,
                ReferenceHandler = ReferenceHandler.IgnoreCycles 
            };
            
            var jsonString = JsonSerializer.Serialize(items, options);
            await JS.InvokeVoidAsync("window.blazorDownloadJson", "BulletItems_Export.json", jsonString);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export Error: {ex.Message}");
        }
    }
}