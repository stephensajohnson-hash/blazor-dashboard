@page "/export-data"
@using Dashboard.Components.Bullet

<div class="min-h-screen bg-[#050505] text-white p-6 font-sans">
    <BulletHeader />

    <div class="max-w-5xl mx-auto mt-8">
        <h1 class="text-3xl font-black uppercase italic tracking-tighter text-emerald-400 mb-2">Data Export Hub</h1>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
            
            @* MEDIA EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl flex flex-col">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-emerald-500/20 flex items-center justify-center text-2xl">🎬</div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Media Export</h2>
                        <p class="text-[10px] font-mono text-gray-500">JSON Format</p>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mb-8 flex-1">
                    Exports all media tracking records, details, and associated notes.
                </p>
                
                <a href="/api/export/media" target="_top"
                   class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black uppercase tracking-widest px-8 py-4 rounded-xl transition text-center block">
                    DOWNLOAD MEDIA JSON
                </a>
            </div>

            @* MEETING EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl flex flex-col">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-blue-500/20 flex items-center justify-center text-2xl">🤝</div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Meeting Export</h2>
                        <p class="text-[10px] font-mono text-gray-500">JSON Format</p>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mb-8 flex-1">
                    Exports all meetings, durations, completion statuses, and associated notes.
                </p>
                
                <a href="/api/export/meetings" target="_top"
                   class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-black uppercase tracking-widest px-8 py-4 rounded-xl transition text-center block">
                    DOWNLOAD MEETING JSON
                </a>
            </div>

            @* TASK EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl flex flex-col">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-purple-500/20 flex items-center justify-center text-2xl">✅</div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Task Export</h2>
                        <p class="text-[10px] font-mono text-gray-500">JSON Format</p>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mb-8 flex-1">
                    Exports all tasks, priority levels, due dates, todo checklists, and notes.
                </p>
                
                <a href="/api/export/tasks" target="_top"
                   class="bg-purple-600 hover:bg-purple-500 text-white text-xs font-black uppercase tracking-widest px-8 py-4 rounded-xl transition text-center block">
                    DOWNLOAD TASK JSON
                </a>
            </div>

        </div>

        <p class="mt-6 text-[10px] text-gray-500 text-center">
            Direct GET requests. Bypasses Blazor routing completely.
        </p>
    </div>
</div>