@page "/export-data"
@using Dashboard.Components.Bullet

<div class="min-h-screen bg-[#050505] text-white p-6 font-sans">
    <BulletHeader />

    <div class="max-w-5xl mx-auto mt-8">
        <h1 class="text-3xl font-black uppercase italic tracking-tighter text-emerald-400 mb-2">Data Export Hub</h1>
        
        <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl">
            @* The most reliable way: A standard HTML Form *@
            <form action="/api/export/media" method="post">
                <button type="submit" 
                        class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black uppercase tracking-widest px-8 py-4 rounded-xl transition">
                    DOWNLOAD MEDIA JSON (DIRECT)
                </button>
            </form>
            
            <p class="mt-4 text-[10px] text-gray-500">
                This uses a direct server-side post. If this doesn't trigger a download, the issue is your browser's popup blocker.
            </p>
        </div>
    </div>
</div>