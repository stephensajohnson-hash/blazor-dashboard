@page "/export-data"
@using Dashboard
@using Dashboard.Components.Bullet
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using Microsoft.JSInterop
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<div class="min-h-screen bg-[#050505] text-white p-6 font-sans">
    <BulletHeader />

    <div class="max-w-5xl mx-auto mt-8">
        <h1 class="text-3xl font-black uppercase italic tracking-tighter text-emerald-400 mb-2">Data Export Hub</h1>
        <p class="text-slate-400 text-sm font-bold tracking-widest uppercase mb-8">Migrate your data to Replit</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            @* MEDIA EXPORT CARD *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-6 flex flex-col gap-4 shadow-xl hover:border-emerald-500/50 transition-colors">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-emerald-500/20 flex items-center justify-center text-2xl">
                        🎬
                    </div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Media & Movies</h2>
                        <p class="text-[10px] font-mono text-gray-500">JSON Format</p>
                    </div>
                </div>
                
                <p class="text-xs text-gray-400 flex-1">
                    Exports all movies, shows, and media tracking records from the database.
                </p>

                <button @onclick="ExportMedia" disabled="@isExporting" class="w-full bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 disabled:cursor-not-allowed text-white text-xs font-black uppercase tracking-widest py-3 rounded-xl transition flex items-center justify-center gap-2">
                    @if (isExporting && currentExport == "Media")
                    {
                        <span class="animate-spin text-lg">⚙️</span> <span>Exporting...</span>
                    }
                    else
                    {
                        <span>📥</span> <span>Download JSON</span>
                    }
                </button>
            </div>

            @* TEMPLATE CARD FOR FUTURE EXPORTS (Tasks, Health, etc) *@
            <div class="bg-[#111] border border-gray-800 rounded-2xl p-6 flex flex-col gap-4 shadow-xl opacity-50 grayscale">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-blue-500/20 flex items-center justify-center text-2xl">
                        ✅
                    </div>
                    <div>
                        <h2 class="text-lg font-black uppercase text-white">Tasks & Todos</h2>
                        <p class="text-[10px] font-mono text-gray-500">Coming Soon</p>
                    </div>
                </div>
                <p class="text-xs text-gray-400 flex-1">Placeholder for your next export module.</p>
                <button disabled class="w-full bg-gray-800 text-gray-500 text-xs font-black uppercase tracking-widest py-3 rounded-xl">Pending</button>
            </div>

        </div>
    </div>
</div>

@code {
    private bool isExporting = false;
    private string currentExport = "";

    private async Task ExportMedia()
    {
        isExporting = true;
        currentExport = "Media";
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            // Adjust "db.Movies" below to whatever your DbSet is named in AppDbContext
            var mediaItems = await db.Movies.AsNoTracking().ToListAsync();

            // Format nicely so it's readable
            var options = new JsonSerializerOptions { WriteIndented = true };
            var jsonString = JsonSerializer.Serialize(mediaItems, options);

            // Generate filename with timestamp
            var fileName = $"PPP_MediaExport_{DateTime.Now:yyyyMMdd_HHmmss}.json";

            // Trigger Browser Download via injected JS
            await TriggerFileDownload(fileName, jsonString);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            currentExport = "";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Executes a dynamic JavaScript snippet to create a Blob and force the browser to download it.
    /// This avoids needing to add scripts to _Host.cshtml.
    /// </summary>
    private async Task TriggerFileDownload(string filename, string fileContent)
    {
        var jsSnippet = @"
            (function(filename, content) {
                const blob = new Blob([content], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const anchor = document.createElement('a');
                anchor.href = url;
                anchor.download = filename;
                document.body.appendChild(anchor);
                anchor.click();
                document.body.removeChild(anchor);
                URL.revokeObjectURL(url);
            })";

        await JS.InvokeVoidAsync("eval", $"{jsSnippet}('{JSStringEscape(filename)}', `{JSStringEscape(fileContent)}`)");
    }

    // Helper to safely pass strings into the eval function
    private string JSStringEscape(string text)
    {
        if (string.IsNullOrEmpty(text)) return text;
        return text.Replace("\\", "\\\\").Replace("`", "\\`").Replace("$", "\\$");
    }
}