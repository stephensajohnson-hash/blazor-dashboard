@page "/export-data"
@using Dashboard
@using Dashboard.Components.Bullet
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IDbContextFactory<AppDbContext> DbFactory

<div class="min-h-screen bg-[#050505] text-white p-6 font-sans">
    <BulletHeader />

    <div class="max-w-5xl mx-auto mt-8">
        <h1 class="text-3xl font-black uppercase italic tracking-tighter text-emerald-400 mb-2">Data Export Hub</h1>
        
        <div class="bg-[#111] border border-gray-800 rounded-2xl p-8 shadow-xl">
            @if (string.IsNullOrEmpty(downloadUrl))
            {
                <button @onclick="GenerateExport" disabled="@isExporting" 
                        class="bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white text-xs font-black uppercase tracking-widest px-8 py-4 rounded-xl transition">
                    @(isExporting ? "PREPARING JSON..." : "GENERATE MEDIA DATA")
                </button>
            }
            else
            {
                @* NATIVE DOWNLOAD LINK *@
                <a href="@downloadUrl" 
                   download="BulletMediaExport.json" 
                   class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-black uppercase tracking-widest px-8 py-4 rounded-xl transition inline-block">
                    CLICK TO SAVE: BulletMediaExport.json
                </a>
                <button @onclick="Reset" class="ml-4 text-gray-500 underline text-xs">Reset</button>
            }
        </div>
    </div>
</div>

@code {
    private bool isExporting = false;
    private string downloadUrl = "";

    private async Task GenerateExport()
    {
        isExporting = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            // 1. Fetch using the correct table (BulletItems)
            var items = await db.BulletItems
                .AsNoTracking()
                .Where(i => i.Type == "media" || i.Type == "Media") 
                .Include(i => i.DbMediaDetail)
                .Include(i => i.Notes)
                .ToListAsync();

            // 2. Serialize
            var options = new JsonSerializerOptions 
            { 
                WriteIndented = true,
                ReferenceHandler = ReferenceHandler.IgnoreCycles 
            };
            
            var jsonString = JsonSerializer.Serialize(items, options);
            
            // 3. Create a Data URI for the browser to download directly
            var base64Data = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(jsonString));
            downloadUrl = $"data:application/json;base64,{base64Data}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export Failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private void Reset() => downloadUrl = "";
}