@page "/ppp-order-success/{OrderId:int}"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="min-h-screen w-full bg-[#050505] text-slate-200 flex items-center justify-center p-6 font-sans antialiased">
    <div class="max-w-md w-full bg-[#111] border border-slate-800 rounded-[3rem] p-12 text-center shadow-2xl">
        
        <div class="w-20 h-20 bg-emerald-500/20 rounded-full flex items-center justify-center mx-auto mb-8">
            <span class="text-3xl">✅</span>
        </div>

        <h1 class="text-4xl font-black text-white uppercase italic tracking-tighter mb-2">Confirmed</h1>
        <p class="text-slate-500 font-bold uppercase tracking-widest text-[10px] mb-8">Order ID: #@OrderId</p>

        <div class="bg-black/50 border border-white/5 rounded-3xl p-6 mb-10">
            <p class="text-[9px] font-black text-slate-500 uppercase tracking-widest mb-1">Total Amount Due</p>
            <p class="text-4xl font-black text-white italic">$@TotalAmount.ToString("N2")</p>
        </div>

        @if (!string.IsNullOrEmpty(WebUrl))
        {
            <div class="space-y-4">
                <button @onclick="LaunchVenmo" 
                        class="w-full bg-[#008CFF] hover:bg-[#0074D9] text-white py-6 rounded-2xl font-black text-lg uppercase tracking-widest transition-all shadow-[0_15px_40px_rgba(0,140,255,0.3)] active:scale-95 flex items-center justify-center gap-3">
                    <span>Pay with Venmo</span>
                </button>
                <div class="px-4 text-[9px] text-slate-500 font-black uppercase leading-tight">
                    @if (isMobile) { <span>Opening Venmo App...</span> }
                    else { <span>Redirecting to Venmo Web...</span> }
                </div>
            </div>
        }
        else
        {
            <div class="p-6 bg-amber-500/10 border border-amber-500/20 rounded-2xl">
                <p class="text-xs font-bold text-amber-500 uppercase">Manual Payment Required</p>
            </div>
        }

        <button @onclick="GoHome" class="mt-12 text-slate-600 hover:text-white text-[10px] font-black uppercase tracking-[0.2em] transition-colors">
            ← Back to Storefront
        </button>
    </div>
</div>

@code {
    [Parameter] public int OrderId { get; set; }
    private string? AppUrl { get; set; }
    private string? WebUrl { get; set; }
    private double TotalAmount { get; set; }
    private bool isMobile = false;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("appUrl", out var app)) AppUrl = app;
        if (query.TryGetValue("webUrl", out var web)) WebUrl = web;
        if (query.TryGetValue("total", out var totalStr) && double.TryParse(totalStr, out var total)) TotalAmount = total;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Simple mobile detection
            var ua = await JS.InvokeAsync<string>("eval", "navigator.userAgent");
            isMobile = ua.Contains("Android") || ua.Contains("iPhone") || ua.Contains("iPad");
            StateHasChanged();
        }
    }

    private async Task LaunchVenmo()
    {
        if (string.IsNullOrEmpty(WebUrl)) return;

        if (!isMobile)
        {
            // Desktop: Skip the deep link attempt entirely
            Nav.NavigateTo(WebUrl, forceLoad: true);
        }
        else
        {
            // Mobile: Try the app, fallback to web
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    const appUrl = '{AppUrl}';
                    const webUrl = '{WebUrl}';
                    
                    // Attempt app
                    window.location.href = appUrl;
                    
                    // If page is still visible after 1.5s, app failed
                    setTimeout(function() {{
                        if (!document.hidden) {{
                            window.location.href = webUrl;
                        }}
                    }}, 1500);
                }})()
            ");
        }
    }

    private void GoHome() => Nav.NavigateTo("/ppp-owner-admin"); 
}