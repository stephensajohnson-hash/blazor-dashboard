@page "/ppp-admin/impersonator"
@using Dashboard
@using Dashboard.Services
@using Dashboard.Components
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Main Container with single scrollbar fix *@
<div class="h-screen w-full bg-[#050505] text-slate-200 font-sans antialiased overflow-hidden flex flex-col">
    
    <div class="p-8">
        <PPPAdminNav CurrentPage="Identity Lab" />
    </div>

    @* Scrollable Content Area *@
    <div class="flex-1 overflow-y-auto px-8 pb-40">
        <div class="max-w-4xl mx-auto mt-4">
            <div class="mb-12">
                <h1 class="text-4xl font-black text-white italic uppercase tracking-tighter">Identity Lab</h1>
                <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.3em] mt-1">Admin Impersonation & Testing Tool</p>
            </div>

            @if (!isAuthorized)
            {
                <div class="p-10 bg-red-950/20 border border-red-500/50 rounded-[2.5rem] text-center">
                    <p class="text-red-400 font-black uppercase text-xs tracking-widest">⚠️ Authorization Required</p>
                    <p class="text-slate-500 text-[10px] mt-2">Checking administrative credentials...</p>
                </div>
            }
            else
            {
                @* User Search Section *@
                <div class="bg-[#111] border border-slate-800 rounded-[2.5rem] p-10 shadow-2xl mb-8">
                    <div class="flex justify-between items-center mb-8">
                        <h2 class="text-xl font-black text-white uppercase italic tracking-widest flex items-center gap-4 flex-1">
                            Search Users
                            <span class="h-[1px] flex-1 bg-white/5"></span>
                        </h2>
                    </div>

                    <div class="relative mb-10">
                        <input @bind="searchQuery" 
                               @bind:event="oninput" 
                               @onkeyup="HandleKeyUp"
                               placeholder="Search by Name or Email..." 
                               class="w-full bg-black border border-slate-800 rounded-2xl p-6 text-lg text-white outline-none focus:border-emerald-500 transition-all font-bold italic shadow-inner" />
                        <div class="absolute right-6 top-6 text-slate-700">🔍</div>
                    </div>

                    <div class="space-y-4">
                        @foreach (var user in foundUsers)
                        {
                            <div class="flex items-center justify-between p-6 bg-black/40 rounded-3xl border border-white/5 hover:border-emerald-500/30 transition-all group">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-full bg-emerald-900/20 border border-emerald-500/20 flex items-center justify-center text-xs font-black text-emerald-500">
                                        @user.FirstName[0]@user.LastName[0]
                                    </div>
                                    <div>
                                        <span class="text-sm font-black uppercase text-white block">@user.FirstName @user.LastName</span>
                                        <span class="text-[10px] font-mono text-slate-500">@user.Email</span>
                                    </div>
                                </div>
                                <button @onclick="() => Impersonate(user)" 
                                        class="bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all shadow-lg opacity-0 group-hover:opacity-100 active:scale-95">
                                    Impersonate
                                </button>
                            </div>
                        }

                        @if (!foundUsers.Any() && !string.IsNullOrEmpty(searchQuery))
                        {
                            <div class="text-center py-10 opacity-30">
                                <p class="text-[10px] font-black uppercase tracking-widest">No users found matching "@searchQuery"</p>
                            </div>
                        }
                    </div>
                </div>

                @* Safety Revert *@
                <div class="bg-blue-900/10 border border-blue-500/20 rounded-[2.5rem] p-10 flex flex-col md:flex-row justify-between items-center gap-6">
                    <div class="text-center md:text-left">
                        <span class="text-[10px] font-black uppercase text-blue-400 block mb-1 tracking-widest">Identity Safety Switch</span>
                        <p class="text-xs text-slate-500 max-w-md leading-relaxed">
                            Clicking the button below will clear your current identity cookie. You will need to use your original magic link to log back in as an admin.
                        </p>
                    </div>
                    <button @onclick="ClearIdentity" class="bg-blue-600 hover:bg-blue-500 text-white px-10 py-5 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] transition-all shadow-xl active:scale-95">
                        Logout / Reset All
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string searchQuery = "";
    private List<PPP_User> foundUsers = new();
    private bool isAuthorized = false;
    private PPP_User? currentAdmin;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckAdminAuth();
        }
    }

    private async Task CheckAdminAuth()
    {
        var token = await JS.InvokeAsync<string>("eval", @"
            (function() {
                var name = 'ppp_token=';
                var ca = document.cookie.split(';');
                for(var i = 0; i < ca.length; i++) {
                    var c = ca[i].trim();
                    if (c.indexOf(name) == 0) return c.substring(name.length, c.length);
                }
                return null;
            })()");

        if (!string.IsNullOrEmpty(token))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.PPP_Users.FirstOrDefaultAsync(u => u.MagicToken == token);
            
            if (user != null && user.Role == "Admin")
            {
                currentAdmin = user;
                isAuthorized = true;
                StateHasChanged();
            }
            else
            {
                Nav.NavigateTo("/");
            }
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        await PerformSearch();
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || searchQuery.Length < 2)
        {
            foundUsers.Clear();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var q = searchQuery.ToLower().Trim();

        foundUsers = await db.PPP_Users
            .Where(u => u.Email.ToLower().Contains(q) || 
                        u.FirstName.ToLower().Contains(q) || 
                        u.LastName.ToLower().Contains(q))
            .Take(10)
            .ToListAsync();
    }

// Locate the Impersonate method in your PPPImpersonator.razor and update it:
private async Task Impersonate(PPP_User target)
{
    if (string.IsNullOrEmpty(target.MagicToken))
    {
        target.MagicToken = Guid.NewGuid().ToString("N");
        target.TokenExpiresAt = DateTime.UtcNow.AddMonths(6);
        
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Entry(target).State = EntityState.Modified;
        await db.SaveChangesAsync();
    }

    // 1. SAVE YOUR ADMIN TOKEN TO A BACKUP COOKIE (The Safety Rope)
    // We'll call it 'ppp_admin_backdoor'
    await JS.InvokeVoidAsync("eval", $"document.cookie = 'ppp_admin_backdoor={originalAdminToken}; max-age={60*60*2}; path=/; SameSite=Lax';");

    // 2. Overwrite the main token to become the user
    await JS.InvokeVoidAsync("eval", $"document.cookie = 'ppp_token={target.MagicToken}; max-age={60*60*24*180}; path=/; SameSite=Lax';");
    
    // 3. Go to the store as the new user
    Nav.NavigateTo($"/ppp-store/1", forceLoad: true);
}

    private async Task ClearIdentity()
    {
        await JS.InvokeVoidAsync("eval", "document.cookie = 'ppp_token=; max-age=0; path=/;';");
        Nav.NavigateTo("/", forceLoad: true);
    }
}