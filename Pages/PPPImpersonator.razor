@page "/ppp-admin/impersonator"
@using Dashboard
@using Dashboard.Services
@using Dashboard.Components
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="h-screen w-full bg-[#050505] text-slate-200 font-sans antialiased overflow-hidden flex flex-col">
    <div class="p-8">
        <PPPAdminNav CurrentPage="Identity Lab" />
    </div>

    <div class="flex-1 overflow-y-auto px-8 pb-40">
        <div class="max-w-4xl mx-auto mt-4">
            <div class="mb-12">
                <h1 class="text-4xl font-black text-white italic uppercase tracking-tighter">Identity Lab</h1>
                <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.3em] mt-1">Admin Impersonation & Testing Tool</p>
            </div>

            @if (!isAuthorized)
            {
                <div class="py-20 text-center">
                    <div class="w-12 h-12 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                    <p class="text-xs font-black uppercase tracking-widest text-slate-500">Verifying Admin Permissions...</p>
                </div>
            }
            else
            {
                <div class="bg-[#111] border border-slate-800 rounded-[2.5rem] p-10 shadow-2xl mb-8">
                    <div class="flex justify-between items-center mb-8">
                        <h2 class="text-xl font-black text-white uppercase italic tracking-widest flex items-center gap-4 flex-1">
                            Search Registry
                            <span class="h-[1px] flex-1 bg-white/5"></span>
                        </h2>
                    </div>

                    <div class="relative mb-10">
                        <input @bind="searchQuery" 
                               @bind:event="oninput" 
                               @onkeyup="HandleKeyUp"
                               placeholder="Search by Name or Email..." 
                               class="w-full bg-black border border-slate-800 rounded-2xl p-6 text-lg text-white outline-none focus:border-emerald-500 transition-all font-bold italic shadow-inner" />
                        <div class="absolute right-6 top-6 text-slate-700 pointer-events-none">🔍</div>
                    </div>

                    <div class="space-y-4">
                        @foreach (var user in foundUsers)
                        {
                            <div class="flex items-center justify-between p-6 bg-black/40 rounded-3xl border border-white/5 hover:border-emerald-500/30 transition-all group">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-full bg-emerald-900/20 border border-emerald-500/20 flex items-center justify-center text-xs font-black text-emerald-500">
                                        @(user.FirstName?.Length > 0 ? user.FirstName[0] : '?')@(user.LastName?.Length > 0 ? user.LastName[0] : '?')
                                    </div>
                                    <div>
                                        <span class="text-sm font-black uppercase text-white block">@user.FirstName @user.LastName</span>
                                        <span class="text-[10px] font-mono text-slate-500">@user.Email</span>
                                    </div>
                                </div>
                                <button @onclick="() => Impersonate(user)" 
                                        class="bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all shadow-lg opacity-0 group-hover:opacity-100 active:scale-95">
                                    Impersonate
                                </button>
                            </div>
                        }

                        @if (!foundUsers.Any() && !string.IsNullOrEmpty(searchQuery))
                        {
                            <div class="text-center py-10 opacity-30">
                                <p class="text-[10px] font-black uppercase tracking-widest">No users matching "@searchQuery"</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string searchQuery = "";
    private List<PPP_User> foundUsers = new();
    private bool isAuthorized = false;
    private PPP_User? currentAdmin;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await CheckAdminAuth();
    }

    private async Task CheckAdminAuth()
    {
        var token = await JS.InvokeAsync<string>("eval", "document.cookie.split('; ').find(row => row.startsWith('ppp_token='))?.split('=')[1]");

        if (!string.IsNullOrEmpty(token))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.PPP_Users.FirstOrDefaultAsync(u => u.MagicToken == token);
            
            if (user != null && user.Role == "Admin")
            {
                currentAdmin = user;
                isAuthorized = true;
                await InvokeAsync(StateHasChanged);
            }
            else Nav.NavigateTo("/");
        }
        else Nav.NavigateTo("/");
    }

    private async Task HandleKeyUp(KeyboardEventArgs e) => await PerformSearch();

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || searchQuery.Length < 2)
        {
            foundUsers.Clear();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var q = searchQuery.ToLower().Trim();

        foundUsers = await db.PPP_Users
            .Where(u => u.Email.ToLower().Contains(q) || u.FirstName.ToLower().Contains(q) || u.LastName.ToLower().Contains(q))
            .Take(10)
            .ToListAsync();
    }

    private async Task Impersonate(PPP_User target)
    {
        if (currentAdmin == null) return;

        // Simply put on the mask in the database
        await using var db = await DbFactory.CreateDbContextAsync();
        var adminToUpdate = await db.PPP_Users.FindAsync(currentAdmin.Id);
        if (adminToUpdate != null)
        {
            adminToUpdate.ImpersonatingEmail = target.Email;
            await db.SaveChangesAsync();
        }
        
        Nav.NavigateTo($"/ppp-store/1", forceLoad: true);
    }
}