@page "/ppp-dashboard"
@using Dashboard
@using Dashboard.Services
@using Dashboard.Components
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Main container fixed to screen height to prevent double scrollbars *@
<div class="h-screen w-full bg-[#050505] text-slate-200 font-sans antialiased overflow-hidden flex flex-col">
    
    <div class="p-8">
        <PPPAdminNav CurrentPage="System Overview" />
    </div>

    @* Notification Stack *@
    <div class="fixed top-24 right-6 z-[100] flex flex-col gap-3">
        @foreach (var toast in toasts)
        {
            <div class="p-4 rounded-2xl border shadow-2xl animate-in slide-in-from-right duration-300 @(toast.IsError ? "bg-red-950/90 border-red-500 text-red-200" : "bg-emerald-950/90 border-emerald-500 text-emerald-200")">
                <div class="flex items-center gap-3">
                    <span>@(toast.IsError ? "✕" : "✓")</span>
                    <span class="text-xs uppercase tracking-widest font-black">@toast.Message</span>
                </div>
            </div>
        }
    </div>

    @* Scrollable Content Area *@
    <div class="flex-1 overflow-y-auto px-8 pb-40">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
                <div>
                    <h1 class="text-4xl font-black text-white italic uppercase tracking-tighter">System Console</h1>
                    <p class="text-purple-500 text-[10px] font-black uppercase tracking-[0.3em] mt-1">Infrastructure & Database Management</p>
                </div>
                
                <button @onclick="InitializePPP" class="bg-purple-600 hover:bg-purple-500 text-white px-8 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all shadow-xl active:scale-95 border border-purple-400/20">
                    ⚡ Initialize & Rescue Admin
                </button>
            </div>

            @if (isLoading)
            {
                <div class="py-20 text-center">
                    <div class="w-12 h-12 border-4 border-purple-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                    <p class="text-[10px] font-black uppercase text-slate-600 tracking-widest">Synchronizing_Environment...</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                    <div class="bg-[#111] border border-slate-800 p-8 rounded-[2rem] shadow-xl">
                        <span class="text-[9px] text-slate-500 uppercase font-black block mb-2">Total Revenue</span>
                        <span class="text-3xl font-black text-white italic tracking-tight">$@Stats.TotalRevenue.ToString("N2")</span>
                    </div>
                    <div class="bg-[#111] border border-slate-800 p-8 rounded-[2rem] shadow-xl">
                        <span class="text-[9px] text-slate-500 uppercase font-black block mb-2">Active Orders</span>
                        <span class="text-3xl font-black text-emerald-500 italic tracking-tight">@Stats.ActiveOrders</span>
                    </div>
                    <div class="bg-[#111] border border-slate-800 p-8 rounded-[2rem] shadow-xl">
                        <span class="text-[9px] text-slate-500 uppercase font-black block mb-2">Registered Users</span>
                        <span class="text-3xl font-black text-blue-500 italic tracking-tight">@Stats.UserCount</span>
                    </div>
                </div>

                <div class="bg-[#111] border border-slate-800 rounded-[2.5rem] p-10 shadow-2xl">
                    <h2 class="text-xl font-black text-white uppercase italic tracking-widest mb-8 flex items-center gap-4">
                        Environment Logs
                        <span class="h-[1px] flex-1 bg-white/5"></span>
                    </h2>
                    <div class="bg-black rounded-2xl p-6 font-mono text-[10px] text-slate-400 space-y-2 max-h-64 overflow-y-auto shadow-inner border border-white/5">
                        @foreach (var log in logs)
                        {
                            <div class="flex gap-4">
                                <span class="text-slate-700">[@DateTime.Now.ToString("HH:mm:ss")]</span>
                                <span>@log</span>
                            </div>
                        }
                        @if (!logs.Any())
                        {
                            <p class="italic opacity-20 uppercase tracking-widest">No log entries for current session.</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isLoading = true;
    private List<string> logs = new();
    private List<ToastItem> toasts = new();
    private DashboardStats Stats = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        isLoading = true;
        try 
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            Stats.UserCount = await db.PPP_Users.CountAsync();
            Stats.ActiveOrders = await db.PPP_Orders.CountAsync(o => o.IsCheckedOut);
            
            var revenue = await db.PPP_OrderItems
                .Where(i => i.ParentOrderContainer != null && i.ParentOrderContainer.IsCheckedOut)
                .SumAsync(i => i.BasePrice + i.DeliveryFee);
                
            Stats.TotalRevenue = revenue;
            logs.Add("System stats synchronized successfully.");
        }
        catch (Exception ex) 
        {
            logs.Add($"Error loading stats: {ex.Message}");
        }
        finally 
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

 private async Task InitializePPP()
{
    logs.Add("Checking infrastructure...");
    try 
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // Inside the DO $$ block in your InitializePPP method:
        await db.Database.ExecuteSqlRawAsync(@"
            DO $$ 
            BEGIN 
                -- ... existing checks ...

                -- Add CalculatedDistanceMiles to PPP_OrderItems
                IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name='PPP_OrderItems' AND column_name='CalculatedDistanceMiles') THEN
                    ALTER TABLE ""PPP_OrderItems"" ADD COLUMN ""CalculatedDistanceMiles"" double precision NOT NULL DEFAULT 0;
                END IF;

            END $$;
        ");

        await db.Database.ExecuteSqlRawAsync(@"
            DO $$ 
            BEGIN 
                -- 1. Ensure AllowCustomServingNotes exists on PPP_Owners
                IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name='PPP_Owners' AND column_name='AllowCustomServingNotes') THEN
                    ALTER TABLE ""PPP_Owners"" ADD COLUMN ""AllowCustomServingNotes"" boolean NOT NULL DEFAULT false;
                END IF;

                -- 2. Ensure Notes exists on PPP_OrderItemServings
                IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name='PPP_OrderItemServings' AND column_name='Notes') THEN
                    ALTER TABLE ""PPP_OrderItemServings"" ADD COLUMN ""Notes"" text;
                END IF;

                -- 3. Ensure ServingsPerUnit exists on PPP_MenuItemSizes (just in case)
                IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name='PPP_MenuItemSizes' AND column_name='ServingsPerUnit') THEN
                    ALTER TABLE ""PPP_MenuItemSizes"" ADD COLUMN ""ServingsPerUnit"" integer NOT NULL DEFAULT 1;
                END IF;
            END $$;
        ");
        
        logs.Add("Database schema updated: Serving Notes and Unit Servings verified.");
        
        // ... (rest of your initialization logic)
    }
    catch (Exception ex) 
    { 
        logs.Add($"Infrastructure Error: {ex.Message}");
    }
}
    private async Task ShowToast(string msg, bool isError = false)
    {
        var toast = new ToastItem { Message = msg, IsError = isError };
        toasts.Add(toast);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(4000);
        toasts.Remove(toast);
        await InvokeAsync(StateHasChanged);
    }

    private class DashboardStats
    {
        public int UserCount { get; set; }
        public int ActiveOrders { get; set; }
        public double TotalRevenue { get; set; }
    }

    private class ToastItem { public string Message { get; set; } = ""; public bool IsError { get; set; } }
}