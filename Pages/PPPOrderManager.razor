@page "/ppp-order-manager/{OwnerId:int}"
@using Dashboard
@using Dashboard.Services
@using Dashboard.Components
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.IO
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Fixed double scrollbar: main container is h-screen/overflow-hidden, child is overflow-y-auto *@
<div class="h-screen w-full bg-[#050505] text-slate-200 font-sans antialiased overflow-hidden flex flex-col">
    
    <div class="p-8">
        <PPPAdminNav CurrentPage="Orders" />
    </div>

    @* Scrollable Content Area *@
    <div class="flex-1 overflow-y-auto px-8 pb-40">
        @* Header Section *@
        <div class="max-w-6xl mx-auto mb-12 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
            <div>
                <h1 class="text-4xl font-black text-white italic uppercase tracking-tighter">Kitchen Production</h1>
                <p class="text-emerald-500 text-[10px] font-black uppercase tracking-[0.3em] mt-1">Live Production Feed</p>
            </div>

            @* Status Filter Toggle *@
            <div class="flex bg-[#111] border border-slate-800 p-1 rounded-2xl">
                <button @onclick='() => SetFilter("pending")' class="px-6 py-2 rounded-xl text-[10px] font-black uppercase transition-all @(activeFilter == "pending" ? "bg-emerald-600 text-white shadow-lg" : "text-slate-500 hover:text-slate-300")">Pending</button>
                <button @onclick='() => SetFilter("ready")' class="px-6 py-2 rounded-xl text-[10px] font-black uppercase transition-all @(activeFilter == "ready" ? "bg-blue-600 text-white shadow-lg" : "text-slate-500 hover:text-slate-300")">Ready</button>
                <button @onclick='() => SetFilter("all")' class="px-6 py-2 rounded-xl text-[10px] font-black uppercase transition-all @(activeFilter == "all" ? "bg-slate-700 text-white shadow-lg" : "text-slate-500 hover:text-slate-300")">All</button>
            </div>

            <div class="bg-[#111] border border-slate-800 px-6 py-3 rounded-2xl">
                <span class="text-[9px] text-slate-500 uppercase font-black block">Active Items</span>
                <span class="text-xl font-mono font-bold text-white">@MasterKitchenQueue.Count</span>
            </div>
        </div>

        @* Production Schedule View *@
        <div class="max-w-6xl mx-auto space-y-16">
            @if (!MasterKitchenQueue.Any())
            {
                <div class="py-20 text-center bg-[#111] rounded-[3rem] border border-slate-800 border-dashed">
                    <span class="text-4xl block mb-4">🍳</span>
                    <p class="text-xs font-black uppercase tracking-widest text-slate-600">No production items found.</p>
                </div>
            }
            else
            {
                @foreach (var dayBucket in MasterKitchenQueue.GroupBy(x => x.ScheduledDate.Date).OrderBy(x => x.Key))
                {
                    <div class="space-y-6">
                        <h2 class="text-xl font-black text-white uppercase tracking-widest flex items-center gap-4">
                            <span class="text-emerald-500">@dayBucket.Key.ToString("dddd, MMM d")</span>
                            <span class="h-[1px] flex-1 bg-white/5"></span>
                        </h2>

                        @foreach (var timeBucket in dayBucket.GroupBy(x => x.TimeframeName).OrderBy(x => x.Key))
                        {
                            <div class="bg-[#111] border border-slate-800 rounded-[2.5rem] overflow-hidden shadow-2xl mb-8">
                                <div class="bg-white/5 p-6 border-b border-white/5 flex justify-between items-center">
                                    <div class="flex items-center gap-3">
                                        <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                                        <h3 class="text-sm font-black text-white uppercase italic tracking-widest">Window: @(string.IsNullOrEmpty(timeBucket.Key) ? "Standard" : timeBucket.Key)</h3>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <button @onclick="() => OpenLabelDialog(timeBucket.ToList())" 
                                                class="bg-emerald-600/10 hover:bg-emerald-600 text-emerald-500 hover:text-white px-4 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest border border-emerald-500/20 transition-all flex items-center gap-2">
                                            🏷️ Generate Labels
                                        </button>
                                        <span class="text-[10px] bg-white/10 text-slate-300 px-4 py-2 rounded-xl font-black uppercase">
                                            @timeBucket.Count() Units
                                        </span>
                                    </div>
                                </div>

                                <div class="divide-y divide-white/5">
                                    @foreach (var lineItem in timeBucket)
                                    {
                                        <div class="p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 group hover:bg-white/[0.02] transition-all">
                                            <div class="flex items-center gap-6">
                                                <div class="w-20 h-20 rounded-2xl overflow-hidden bg-black border border-slate-800 shrink-0 shadow-inner">
                                                    @if (lineItem.MenuItem?.Recipe?.ImageId != null)
                                                    {
                                                        <img src="/db-images-ppp/@lineItem.MenuItem.Recipe.ImageId" class="w-full h-full object-cover" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-full h-full flex items-center justify-center text-2xl bg-white/5 text-slate-700">🥘</div>
                                                    }
                                                </div>

                                                <div>
                                                    <div class="flex items-center gap-3 mb-1">
                                                        <p class="text-white font-black uppercase text-base @(lineItem.IsReady ? "line-through opacity-40" : "")">@lineItem.RecipeName</p>
                                                        
                                                        <span class="text-[9px] font-mono text-slate-600">ID: @lineItem.Id</span>
                                                        @if (lineItem.IsReady)
                                                        {
                                                            <span class="bg-blue-500/20 text-blue-400 text-[8px] px-2 py-0.5 rounded font-black uppercase tracking-tighter">Ready</span>
                                                        }
                                                    </div>
                                                    <p class="text-[10px] text-slate-500 font-bold uppercase tracking-widest">@lineItem.SizeName</p>
                                                    
                                                    <div class="mt-2 space-y-1">
                                                        @foreach(var serving in lineItem.Servings)
                                                        {
                                                            <div class="flex items-center gap-2">
                                                                <span class="text-[9px] text-emerald-500 font-black uppercase">Serving @serving.ServingNumber:</span>
                                                                <span class="text-xs text-white italic">@(string.IsNullOrEmpty(serving.LabelName) ? "No Name" : serving.LabelName)</span>
                                                                @if(serving.SelectedOptions != null && serving.SelectedOptions.Any())
                                                                {
                                                                    <span class="text-[9px] text-blue-400 font-bold">+ @string.Join(", ", serving.SelectedOptions.Select(o => o.OptionName))</span>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-4 w-full md:w-auto border-t md:border-t-0 border-white/5 pt-4 md:pt-0">
                                                <div class="text-right flex-1 md:flex-none mr-4">
                                                    <p class="text-[9px] text-slate-500 font-black uppercase mb-1">Customer</p>
                                                    <p class="text-xs font-mono text-white opacity-60">@GetSafeCustId(lineItem)</p>
                                                </div>
                                                
                                                <div class="flex items-center gap-2">
                                                    <button @onclick="() => StartEdit(lineItem)" 
                                                            class="bg-blue-500/10 hover:bg-blue-600 text-blue-500 hover:text-white w-12 h-12 rounded-xl flex items-center justify-center transition-all border border-blue-500/20 active:scale-90">
                                                        <span class="text-lg">✏️</span>
                                                    </button>

                                                    <button @onclick="() => DeleteOrderItem(lineItem.Id)" 
                                                            class="bg-red-500/10 hover:bg-red-600 text-red-500 hover:text-white w-12 h-12 rounded-xl flex items-center justify-center transition-all border border-red-500/20 active:scale-90">
                                                        <span class="text-xl font-bold">✕</span>
                                                    </button>

                                                    <button @onclick="() => ToggleReady(lineItem.Id)"
                                                            class="px-6 py-3 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all border @(lineItem.IsReady ? "bg-slate-800 text-slate-400 border-slate-700" : "bg-emerald-600/10 text-emerald-500 border-emerald-500/20 hover:bg-emerald-600 hover:text-white")">
                                                        @(lineItem.IsReady ? "Undo Ready" : "Mark Ready")
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @* Avery Start Position & Workflow Selection Modal *@
    @if (showLabelDialog)
    {
        <div class="fixed inset-0 bg-black/95 backdrop-blur-md z-[800] flex items-center justify-center p-4" @onmousedown="() => showLabelDialog = false">
            <div @onmousedown:stopPropagation="true" class="bg-[#111] border border-slate-800 w-full max-w-sm rounded-[3rem] p-10 shadow-2xl animate-in zoom-in-95">
                <h2 class="text-2xl font-black text-white uppercase italic tracking-tighter mb-6 text-center">Label Settings</h2>
                
                @* Workflow Toggles *@
                <div class="space-y-3 mb-8">
                    <div @onclick="() => { printOrderLabels = !printOrderLabels; StateHasChanged(); }" 
                         class="cursor-pointer flex items-center justify-between p-4 rounded-2xl border-2 transition-all @(printOrderLabels ? "border-emerald-500 bg-emerald-500/5" : "border-slate-800 opacity-50")">
                        <div class="flex items-center gap-3">
                            <span class="text-lg">🛍️</span>
                            <span class="text-[10px] font-black uppercase text-white">Order Bag Labels</span>
                        </div>
                        <div class="w-4 h-4 rounded-full border border-white/20 @(printOrderLabels ? "bg-emerald-500" : "")"></div>
                    </div>

                    <div @onclick="() => { printContainerLabels = !printContainerLabels; StateHasChanged(); }" 
                         class="cursor-pointer flex items-center justify-between p-4 rounded-2xl border-2 transition-all @(printContainerLabels ? "border-emerald-500 bg-emerald-500/5" : "border-slate-800 opacity-50")">
                        <div class="flex items-center gap-3">
                            <span class="text-lg">🍱</span>
                            <span class="text-[10px] font-black uppercase text-white">Container Labels</span>
                        </div>
                        <div class="w-4 h-4 rounded-full border border-white/20 @(printContainerLabels ? "bg-emerald-500" : "")"></div>
                    </div>

                    @* NEW: Global Macro Toggle for this Batch *@
                    <div @onclick="() => { includeMacros = !includeMacros; StateHasChanged(); }" 
                         class="cursor-pointer flex items-center justify-between p-4 rounded-2xl border-2 transition-all @(includeMacros ? "border-blue-500 bg-blue-500/5" : "border-slate-800 opacity-50")">
                        <div class="flex items-center gap-3">
                            <span class="text-lg">📊</span>
                            <span class="text-[10px] font-black uppercase text-white">Include Macros</span>
                        </div>
                        <div class="w-4 h-4 rounded-full border border-white/20 @(includeMacros ? "bg-blue-500" : "")"></div>
                    </div>
                </div>

                @if (!printOrderLabels && !printContainerLabels)
                {
                    <div class="bg-red-900/20 border border-red-500/50 p-4 rounded-xl mb-6 animate-pulse text-center">
                        <p class="text-[10px] text-red-400 font-black uppercase">⚠️ No labels selected</p>
                    </div>
                }

                <div class="text-center mb-6">
                    <p class="text-[10px] text-slate-500 font-black uppercase tracking-widest">
                        Printing <span class="text-emerald-500">@CalculateTotalLabels()</span> labels
                    </p>
                    <p class="text-[10px] text-slate-500 font-black uppercase tracking-widest mt-1">
                        Across <span class="text-emerald-500">@GetPageString()</span>
                    </p>
                </div>

                <p class="text-[9px] text-slate-400 font-black uppercase mb-4 text-center">Select Avery Start Position</p>
                
                @* Grid: 2 columns, 5 rows to match Avery 5163 sheet *@
                <div class="grid grid-cols-2 gap-3 mb-10 max-w-[200px] mx-auto">
                    @for (int i = 1; i <= 10; i++)
                    {
                        var pos = i;
                        <button @onclick="() => { labelStartPos = pos; StateHasChanged(); }" 
                                class="h-12 rounded-xl border-2 font-black text-sm transition-all flex items-center justify-center @(labelStartPos == pos ? "border-emerald-500 bg-emerald-500 text-white shadow-[0_0_15px_rgba(16,185,129,0.4)]" : "border-slate-800 text-slate-600 hover:border-slate-700")">
                            @pos
                        </button>
                    }
                </div>
                
                <div class="flex flex-col gap-3">
                    <button @onclick="() => GeneratePdf(labelStartPos)" 
                            disabled="@(!printOrderLabels && !printContainerLabels)"
                            class="w-full py-5 bg-emerald-600 hover:bg-emerald-500 disabled:opacity-20 text-white rounded-2xl font-black text-[10px] uppercase tracking-[0.3em] shadow-xl transition-all active:scale-95">
                        Confirm & Create PDF
                    </button>
                    <button @onclick="() => showLabelDialog = false" class="w-full py-4 text-[10px] font-black uppercase text-slate-600 tracking-widest hover:text-white transition-all">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* Edit Modal Overlay *@
    @if (editingItem != null)
    {
        <div class="fixed inset-0 bg-black/90 backdrop-blur-md z-[600] flex items-center justify-center p-4">
            <div class="bg-[#111] border border-slate-800 w-full max-w-lg rounded-[2.5rem] p-8 shadow-2xl animate-in fade-in zoom-in-95 duration-200">
                <div class="flex justify-between items-start mb-8">
                    <div>
                        <h2 class="text-2xl font-black text-white uppercase italic tracking-tighter">Edit Item</h2>
                        <p class="text-[10px] text-emerald-500 font-black uppercase">Production Correction</p>
                    </div>
                    <button @onclick="() => editingItem = null" class="text-slate-500 hover:text-white text-2xl">&times;</button>
                </div>

                <div class="space-y-6">
                    <div>
                        <label class="text-[9px] font-black uppercase text-slate-500 mb-2 block">Production Date</label>
                        <input type="date" @bind="editingItem.ScheduledDate" class="w-full bg-black border border-slate-800 rounded-xl p-4 text-xs text-white outline-none focus:border-emerald-500" />
                    </div>

                    <div>
                        <label class="text-[9px] font-black uppercase text-slate-500 mb-2 block">Timeframe Window</label>
                        <input type="text" @bind="editingItem.TimeframeName" class="w-full bg-black border border-slate-800 rounded-xl p-4 text-xs text-white outline-none focus:border-emerald-500" placeholder="Lunch, Dinner, etc." />
                    </div>

                    <div>
                        <label class="text-[9px] font-black uppercase text-slate-500 mb-2 block">Fulfillment Method</label>
                        <select @bind="editingItem.FulfillmentMethod" class="w-full bg-black border border-slate-800 rounded-xl p-4 text-xs text-white outline-none focus:border-emerald-500">
                            <option value="Pickup">Pickup</option>
                            <option value="Delivery">Delivery</option>
                        </select>
                    </div>
                </div>

                <div class="mt-10 flex gap-3">
                    <button @onclick="() => editingItem = null" class="flex-1 bg-white/5 hover:bg-white/10 text-slate-400 py-4 rounded-2xl text-[9px] font-black uppercase">Cancel</button>
                    <button @onclick="SaveEdit" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white py-4 rounded-2xl text-[9px] font-black uppercase tracking-widest shadow-xl">Save Changes</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int OwnerId { get; set; }
    
    private List<PPP_OrderItem> MasterKitchenQueue = new();
    private List<PPP_PickupLocation> LocationsLookup = new();
    private PPP_OrderItem? editingItem;
    private string activeFilter = "pending";
    
    // Label Generation State
    private bool showLabelDialog = false;
    private bool printOrderLabels = true;
    private bool printContainerLabels = true;
    private bool includeMacros = true; // DEFAULT TO ON
    private int labelStartPos = 1;
    private List<PPP_OrderItem> itemsToPrint = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task SetFilter(string filter) 
    { 
        activeFilter = filter; 
        await LoadData(); 
    }

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.Set<PPP_OrderItem>()
            .Include(i => i.ParentOrderContainer).ThenInclude(o => o.Address) 
            .Include(i => i.MenuItem).ThenInclude(m => m.Recipe)
            .Include(i => i.Servings).ThenInclude(s => s.SelectedOptions)
            .Where(i => i.ParentOrderContainer != null && i.ParentOrderContainer.OwnerId == OwnerId && i.ParentOrderContainer.IsCheckedOut);

        if (activeFilter == "pending") query = query.Where(i => !i.IsReady);
        else if (activeFilter == "ready") query = query.Where(i => i.IsReady);

        MasterKitchenQueue = await query.ToListAsync();
        LocationsLookup = await db.Set<PPP_PickupLocation>().Where(l => l.OwnerId == OwnerId).ToListAsync();
    }

    private void OpenLabelDialog(List<PPP_OrderItem> bucketItems)
    {
        itemsToPrint = bucketItems;
        labelStartPos = 1;
        showLabelDialog = true;
    }

    private int CalculateTotalLabels()
    {
        if (!printOrderLabels && !printContainerLabels) return 0;
        int total = 0;
        var orders = itemsToPrint.GroupBy(x => x.OrderId);
        foreach (var group in orders)
        {
            if (printOrderLabels) total++;
            if (printContainerLabels) total += group.Sum(i => i.Servings.Count);
        }
        return total;
    }

    private string GetPageString()
    {
        int totalNeeded = CalculateTotalLabels();
        if (totalNeeded == 0) return "0 Pages";
        
        int firstPageCapacity = 10 - (labelStartPos - 1);
        int remaining = Math.Max(0, totalNeeded - firstPageCapacity);
        int totalPages = 1 + (int)Math.Ceiling(remaining / 10.0);
        
        return totalPages == 1 ? "1 Page" : $"{totalPages} Pages";
    }

    private async Task GeneratePdf(int startPos)
    {
        if (!printOrderLabels && !printContainerLabels) return;
        showLabelDialog = false;
        
        await using var db = await DbFactory.CreateDbContextAsync();
        var owner = await db.PPP_Owners.FindAsync(OwnerId);
        if (owner == null) return;

        byte[]? logoBytes = null;
        if (owner.LogoId.HasValue)
        {
            var logoImage = await db.Set<PPP_StoredImage>().FindAsync(owner.LogoId.Value);
            logoBytes = logoImage?.Data;
        }

        var customerData = new Dictionary<string, (string Name, string Phone)>();
        foreach(var item in itemsToPrint)
        {
            var email = item.ParentOrderContainer?.CustomerIdentifier;
            if (string.IsNullOrEmpty(email) || customerData.ContainsKey(email)) continue;

            var user = await db.PPP_Users.FirstOrDefaultAsync(u => u.Email == email);
            customerData[email] = user != null ? ($"{user.FirstName} {user.LastName}", FormatPhoneNumber(user.Phone)) : (email, "");
        }

        // Updated service call to pass the macro preference
        var pdfBytes = await LabelService.CreateAveryLabels(
            owner, 
            logoBytes, 
            itemsToPrint, 
            startPos, 
            customerData, 
            printOrderLabels, 
            printContainerLabels,
            includeMacros // PASS PREFERENCE HERE
        );
        
        var fileName = $"Kitchen_Labels_{DateTime.Now:yyyyMMdd_HHmm}.pdf";
        var base64 = Convert.ToBase64String(pdfBytes);
        
        await JS.InvokeVoidAsync("eval", $@"
            (function() {{
                const link = document.createElement('a');
                link.download = '{fileName}';
                link.href = 'data:application/pdf;base64,{base64}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }})()
        ");
    }

    private string FormatPhoneNumber(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "";
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.Length == 10)
            return $"({digits.Substring(0, 3)}) {digits.Substring(3, 3)}-{digits.Substring(6)}";
        if (digits.Length == 11 && digits.StartsWith("1"))
            return $"({digits.Substring(1, 3)}) {digits.Substring(4, 3)}-{digits.Substring(7)}";
        return phone;
    }

    private async Task ToggleReady(int itemId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var item = await db.Set<PPP_OrderItem>().FindAsync(itemId);
        if (item != null)
        {
            item.IsReady = !item.IsReady;
            await db.SaveChangesAsync();
            await LoadData();
        }
    }

    private void StartEdit(PPP_OrderItem item)
    {
        editingItem = item;
    }

    private async Task SaveEdit()
    {
        if (editingItem == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var dbItem = await db.Set<PPP_OrderItem>().FindAsync(editingItem.Id);

        if (dbItem != null)
        {
            dbItem.ScheduledDate = editingItem.ScheduledDate.ToUniversalTime();
            dbItem.TimeframeName = editingItem.TimeframeName;
            dbItem.FulfillmentMethod = editingItem.FulfillmentMethod;
            dbItem.PickupLocationId = editingItem.PickupLocationId;
            dbItem.DeliveryFee = editingItem.DeliveryFee;

            await db.SaveChangesAsync();
            editingItem = null;
            await LoadData();
        }
    }

    private async Task DeleteOrderItem(int itemId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var item = await db.Set<PPP_OrderItem>().FindAsync(itemId);
        if (item != null)
        {
            db.Remove(item);
            await db.SaveChangesAsync();
            await LoadData();
        }
    }

    private string GetSafeCustId(PPP_OrderItem item)
    {
        var parentData = item.ParentOrderContainer;
        if (parentData == null) return "GUEST";
        var cid = parentData.CustomerIdentifier;
        if (string.IsNullOrEmpty(cid)) return "GUEST";
        return cid.Length > 8 ? cid.Substring(0, 8).ToUpper() : cid.ToUpper();
    }
}