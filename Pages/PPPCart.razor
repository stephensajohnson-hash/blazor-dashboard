@page "/ppp-cart/{OwnerId:int}"
@using Dashboard
@using Dashboard.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject PPPCartService CartService
@inject NavigationManager Nav
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<div class="min-h-screen w-full bg-[#050505] text-slate-200 p-8 font-sans antialiased">
    <header class="mb-12 border-b border-white/10 pb-8 flex justify-between items-center">
        <div>
            <h1 class="text-4xl font-black uppercase italic tracking-tighter text-white">Review Cart</h1>
            <button @onclick='() => Nav.NavigateTo($"/ppp-store/{OwnerId}")' class="text-emerald-500 text-xs font-black uppercase mt-2 hover:text-emerald-400 transition-all flex items-center gap-2">
                <span>←</span> Back to Menu
            </button>
        </div>
    </header>

    <div class="max-w-4xl mx-auto space-y-6">
        @if (!CartService.Items.Any())
        {
            <div class="text-center py-24 bg-[#111] rounded-[3rem] border border-white/5 animate-in fade-in zoom-in duration-500">
                <p class="text-slate-500 font-black uppercase tracking-[0.3em] text-sm">Your cart is empty</p>
                <button @onclick='() => Nav.NavigateTo($"/ppp-store/{OwnerId}")' class="mt-8 bg-white/5 hover:bg-white/10 text-white px-8 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all">Go to Menu</button>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var item in CartService.Items)
                {
                    <div class="bg-[#111] border border-slate-800 rounded-[2.5rem] p-8 flex flex-col md:flex-row gap-8 shadow-xl">
                        @if (item.ImageId != null)
                        {
                            <div class="w-32 h-32 rounded-2xl overflow-hidden shrink-0 border border-white/5">
                                <img src="/db-images-ppp/@item.ImageId" class="w-full h-full object-cover" />
                            </div>
                        }
                        <div class="flex-1">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h4 class="text-2xl font-black text-white uppercase italic tracking-tight">@item.RecipeName</h4>
                                    <div class="flex flex-wrap items-center gap-2 mt-1">
                                        <span class="text-emerald-500 text-[10px] font-black uppercase tracking-[0.2em]">@item.SizeName • @item.TimeSlot</span>
                                        <span class="h-1 w-1 bg-slate-700 rounded-full"></span>
                                        <span class="text-blue-400 text-[10px] font-black uppercase tracking-widest">📍 @item.DeliveryAddressSummary</span>
                                    </div>
                                </div>
                                <button @onclick="() => CartService.RemoveItem(item.CartItemId)" class="text-slate-600 hover:text-rose-500 text-xl p-2 transition-colors">✕</button>
                            </div>
                            
                            <div class="mt-6 space-y-3">
                                @foreach (var s in item.Servings)
                                {
                                    <div class="bg-white/[0.03] p-4 rounded-2xl border border-white/5 flex flex-col gap-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-[10px] font-black text-emerald-500 uppercase">Portion</span>
                                            <span class="font-bold text-white text-sm">@s.Label</span>
                                        </div>
                                        @if(s.SelectedOptionNames.Any()) 
                                        { 
                                            <div class="flex flex-wrap gap-2 mt-1">
                                                @for(int i=0; i < s.SelectedOptionNames.Count; i++)
                                                {
                                                    <span class="text-[9px] font-black uppercase bg-black px-2 py-0.5 rounded-md text-slate-400 border border-white/5">
                                                        @s.SelectedOptionNames[i] (+$@s.SelectedOptionPrices[i].ToString("N2"))
                                                    </span>
                                                }
                                            </div>
                                        }
                                        @if(!string.IsNullOrEmpty(s.Notes)) 
                                        { 
                                            <p class="text-[11px] text-amber-500 italic mt-1 bg-amber-500/5 p-2 rounded-lg border border-amber-500/10 font-medium">"@s.Notes"</p> 
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="md:w-32 flex flex-col items-end justify-between pt-2">
                            <div class="text-right">
                                @{ double optSum = item.Servings.Sum(s => s.SelectedOptionPrices.Sum()); }
                                <div class="text-[10px] font-black text-slate-500 uppercase">Meal: $@((item.Price - optSum).ToString("N2"))</div>
                                @if(item.DeliveryFee > 0) { <div class="text-[10px] font-black text-blue-500 uppercase">Delivery: +$@item.DeliveryFee.ToString("N2")</div> }
                                <div class="text-2xl font-black text-white pt-2">$@((item.Price + item.DeliveryFee).ToString("N2"))</div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-12 bg-emerald-600 p-10 rounded-[3rem] flex flex-col sm:flex-row justify-between items-center gap-8 shadow-[0_25px_60px_rgba(16,185,129,0.3)] border border-emerald-400/20">
                <div>
                    <p class="text-emerald-200 text-[10px] font-black uppercase tracking-[0.3em]">Final Order Total</p>
                    <p class="text-5xl font-black text-white italic tracking-tighter mt-1">$@CartService.Items.Sum(i => i.Price + i.DeliveryFee).ToString("N2")</p>
                </div>
                
                @if (isProcessing)
                {
                    <div class="flex items-center gap-4 bg-white/10 px-8 py-5 rounded-[1.5rem]">
                        <div class="w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                        <span class="text-xs font-black uppercase text-white tracking-widest">Processing...</span>
                    </div>
                }
                else
                {
                    <button @onclick="ProcessCheckout" class="w-full sm:w-auto bg-white text-emerald-700 px-12 py-5 rounded-[1.5rem] font-black uppercase hover:bg-emerald-50 hover:scale-105 transition-all shadow-xl text-sm">
                        Submit Order →
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int OwnerId { get; set; }
    private bool isProcessing = false;

    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    private async Task ProcessCheckout()
    {
        if (isProcessing) return;
        isProcessing = true;
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string>("eval", "document.cookie.split('; ').find(row => row.startsWith('ppp_token='))?.split('=')[1]");
            await using var db = await DbFactory.CreateDbContextAsync();
            
            var sessionUser = await db.PPP_Users.FirstOrDefaultAsync(u => u.MagicToken == token && u.TokenExpiresAt > DateTime.UtcNow);
            if (sessionUser == null) { Nav.NavigateTo("/ppp-login"); return; }

            // Identify correct customer (impersonation check)
            string finalCustomerId = sessionUser.Id.ToString();
            string finalCustomerName = sessionUser.FirstName;
            if (!string.IsNullOrEmpty(sessionUser.ImpersonatingEmail))
            {
                var targetUser = await db.PPP_Users.FirstOrDefaultAsync(u => u.Email == sessionUser.ImpersonatingEmail);
                if (targetUser != null) 
                {
                    finalCustomerId = targetUser.Id.ToString();
                    finalCustomerName = targetUser.FirstName;
                }
            }

            var owner = await db.PPP_Owners.FindAsync(OwnerId);

            // 1. Create the Order Header
            var order = new PPP_Order
            {
                OwnerId = OwnerId,
                CustomerIdentifier = finalCustomerId,
                CreatedAt = DateTime.UtcNow,
                IsCheckedOut = true,
                CheckedOutAt = DateTime.UtcNow
            };
            db.Set<PPP_Order>().Add(order);
            await db.SaveChangesAsync();

            // 2. Create Order Items
            foreach (var cartItem in CartService.Items)
            {
                var orderItem = new PPP_OrderItem
                {
                    OrderId = order.Id,
                    MenuItemId = cartItem.MenuItemId,
                    RecipeName = cartItem.RecipeName,
                    SizeName = cartItem.SizeName,
                    BasePrice = cartItem.Price - cartItem.Servings.Sum(s => s.SelectedOptionPrices.Sum()), 
                    FulfillmentMethod = cartItem.Fulfillment,
                    TimeframeName = cartItem.TimeSlot,
                    DeliveryFee = cartItem.DeliveryFee,
                    DeliveryAddressSummary = cartItem.DeliveryAddressSummary,
                    CalculatedDistanceMiles = cartItem.CalculatedDistance,
                    ScheduledDate = DateTime.Today.AddDays(1) 
                };
                db.Set<PPP_OrderItem>().Add(orderItem);
                await db.SaveChangesAsync();

                for (int i = 0; i < cartItem.Servings.Count; i++)
                {
                    var serving = cartItem.Servings[i];
                    var orderServing = new PPP_OrderItemServing { OrderItemId = orderItem.Id, ServingNumber = i + 1, LabelName = serving.Label, Notes = serving.Notes };
                    db.Set<PPP_OrderItemServing>().Add(orderServing);
                    await db.SaveChangesAsync();

                    for (int j = 0; j < serving.SelectedOptionNames.Count; j++)
                    {
                        db.Set<PPP_OrderItemOption>().Add(new PPP_OrderItemOption { 
                            OrderItemServingId = orderServing.Id, 
                            OptionName = serving.SelectedOptionNames[j], 
                            AddOnPrice = serving.SelectedOptionPrices[j] 
                        });
                    }
                }
            }

            await db.SaveChangesAsync();
            
            // Generate Venmo Links
            string venmoAppUrl = "";
            string venmoWebUrl = "";
            double orderTotal = CartService.Items.Sum(i => i.Price + i.DeliveryFee);

            if (owner != null && !string.IsNullOrEmpty(owner.VenmoHandle))
            {
                var handle = owner.VenmoHandle.Replace("@", "");
                var note = Uri.EscapeDataString($"Order #{order.Id} for {finalCustomerName}");
                venmoAppUrl = $"venmo://paycharge?txn=pay&recipients={handle}&amount={orderTotal}&note={note}";
                venmoWebUrl = $"https://venmo.com/{handle}?txn=pay&amount={orderTotal}&note={note}";
            }

            CartService.ClearCart();
            
            // Redirect to Success Page with Venmo data in QueryString
            Nav.NavigateTo($"/ppp-order-success/{order.Id}?appUrl={Uri.EscapeDataString(venmoAppUrl)}&webUrl={Uri.EscapeDataString(venmoWebUrl)}&total={orderTotal}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Checkout Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    public void Dispose() => CartService.OnChange -= StateHasChanged;
}