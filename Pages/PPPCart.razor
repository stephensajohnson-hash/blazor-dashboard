@page "/ppp-cart/{OwnerId:int}"
@using Dashboard.Services
@using Microsoft.EntityFrameworkCore
@inject PPPCartService CartService
@inject NavigationManager Nav
@inject IDbContextFactory<AppDbContext> DbFactory

<div class="min-h-screen w-full bg-[#050505] text-slate-200 p-8 font-sans antialiased">
    <header class="mb-12 border-b border-white/10 pb-8 flex justify-between items-center">
        <div>
            <h1 class="text-4xl font-black uppercase italic tracking-tighter text-white">Review Cart</h1>
            <button @onclick='() => Nav.NavigateTo($"/ppp-store/{OwnerId}")' class="text-emerald-500 text-xs font-black uppercase mt-2">← Continue Shopping</button>
        </div>
    </header>

    <div class="max-w-4xl mx-auto space-y-6">
        @if (!CartService.Items.Any())
        {
            <div class="text-center py-20 bg-[#111] rounded-[3rem] border border-white/5">
                <p class="text-slate-500 font-black uppercase tracking-widest">Your cart is empty</p>
            </div>
        }
        else
        {
            @foreach (var item in CartService.Items)
            {
                <div class="bg-[#111] border border-slate-800 rounded-[2.5rem] p-8 flex flex-col md:flex-row gap-8 shadow-xl">
                    @if (item.ImageId != null)
                    {
                        <img src="/db-images-ppp/@item.ImageId" class="w-32 h-32 rounded-2xl object-cover" />
                    }
                    <div class="flex-1">
                        <div class="flex justify-between items-start">
                            <h4 class="text-2xl font-black text-white uppercase italic">@item.RecipeName</h4>
                            <button @onclick="() => CartService.RemoveItem(item.CartItemId)" class="text-rose-500 hover:text-rose-400 text-xl">✕</button>
                        </div>
                        <p class="text-emerald-500 text-xs font-black uppercase tracking-widest mt-1">@item.SizeName • @item.TimeSlot @item.Fulfillment</p>
                        
                        <div class="mt-6 space-y-4">
                            @foreach (var s in item.Servings)
                            {
                                <div class="bg-white/5 p-4 rounded-xl border border-white/5 text-sm">
                                    <span class="font-black text-white">@s.Label</span>
                                    @if(s.SelectedOptionNames.Any()) { <span class="text-slate-400"> • @string.Join(", ", s.SelectedOptionNames)</span> }
                                    @if(!string.IsNullOrEmpty(s.Notes)) { <p class="text-xs text-amber-500 italic mt-1">"@s.Notes"</p> }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="text-2xl font-black text-white self-end md:self-start">$@((item.Price + item.DeliveryFee).ToString("N2"))</div>
                </div>
            }

            <div class="mt-12 bg-emerald-600 p-8 rounded-[2.5rem] flex justify-between items-center shadow-[0_20px_50px_rgba(16,185,129,0.3)]">
                <div>
                    <p class="text-emerald-200 text-[10px] font-black uppercase tracking-widest">Total Amount</p>
                    <p class="text-4xl font-black text-white italic">$@CartService.Items.Sum(i => i.Price + i.DeliveryFee).ToString("N2")</p>
                </div>
                <button class="bg-white text-emerald-600 px-10 py-4 rounded-2xl font-black uppercase tracking-widest hover:scale-105 transition-transform">
                    Checkout →
                </button>
            </div>
        }
    </div>
</div>