@page "/ppp-store/{OwnerId:int}/item/{MenuItemId:int}"
@using Dashboard
@using Dashboard.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject GeocodingService GeoService
@inject PPPCartService CartService

<div class="min-h-screen w-full bg-[#050505] text-slate-200 font-sans antialiased">
    @if (owner != null && item != null)
    {
        @* STICKY HEADER *@
        <div class="sticky top-0 z-[100] bg-[#050505]/80 backdrop-blur-xl border-b border-white/10 px-8 py-6">
            <header class="flex flex-row justify-between items-center gap-6">
                <div class="cursor-pointer group" @onclick="GoBack">
                    <h1 class="text-4xl font-black uppercase italic tracking-tighter text-white group-hover:text-emerald-500 transition-colors">
                        @owner.BusinessName
                    </h1>
                    <p class="text-emerald-500 uppercase tracking-widest text-sm mt-2 font-bold flex items-center gap-2">
                        <span class="text-xl">←</span> Back to Menu
                    </p>
                </div>
                
                <div class="flex items-center gap-6 ml-auto">
                    @if (currentUser != null)
                    {
                        <div class="relative group">
                            <div class="flex items-center gap-4 bg-white/5 p-2 pr-6 rounded-full border border-white/10 cursor-pointer">
                                <div class="w-10 h-10 rounded-full overflow-hidden border border-white/10 shrink-0 bg-emerald-600 flex items-center justify-center font-black text-white">
                                    @if (currentUser.AvatarId.HasValue)
                                    {
                                        <img src="/db-images-ppp/@currentUser.AvatarId" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <span>@currentUser.FirstName?[0]@currentUser.LastName?[0]</span>
                                    }
                                </div>
                                <div class="flex flex-col leading-tight">
                                    <span class="text-sm font-black uppercase text-white">@currentUser.FirstName @currentUser.LastName</span>
                                    @if (isImpersonating)
                                    {
                                        <span class="text-[10px] font-black uppercase text-amber-500 animate-pulse">🕵️ Impersonating</span>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] font-black uppercase text-slate-500 font-bold">Customer</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div @onclick='() => Nav.NavigateTo($"/ppp-cart/{OwnerId}")' class="bg-emerald-500/10 border border-emerald-500/20 px-6 py-3 rounded-2xl flex items-center gap-4 cursor-pointer hover:bg-emerald-500/20 transition-all">
                        <span class="text-2xl">🛒</span>
                        <div class="flex flex-col">
                            <span class="text-[10px] font-black uppercase text-emerald-500 tracking-widest font-bold">Your Cart</span>
                            <span class="text-sm font-bold text-white">@CartService.Items.Count Items</span>
                        </div>
                    </div>
                </div>
            </header>
        </div>

        <div class="p-8 max-w-4xl mx-auto space-y-8 pb-40">
            <div class="bg-[#111] border border-slate-800 rounded-[3rem] overflow-hidden shadow-2xl">
                
                @* Hero Section *@
                <div class="p-12 border-b border-white/5 bg-gradient-to-b from-white/[0.02] to-transparent flex flex-col md:flex-row gap-10">
                    @if (item.Recipe?.ImageId != null)
                    {
                        <div class="w-64 h-64 rounded-[2rem] overflow-hidden bg-black shadow-2xl border border-white/10 shrink-0">
                            <img src="/db-images-ppp/@item.Recipe.ImageId" class="w-full h-full object-cover" />
                        </div>
                    }
                    <div class="flex-1">
                        <span class="text-[10px] font-black uppercase text-emerald-500 tracking-[0.4em] font-bold">Customizing Item</span>
                        <h2 class="text-5xl font-black text-white uppercase italic tracking-tighter mt-2">@item.Recipe?.Name</h2>
                        <p class="text-lg text-slate-300 leading-relaxed font-medium mt-6">@item.Recipe?.LongDescription</p>
                    </div>
                </div>

                <div class="p-12 space-y-12">
                    
                    @* 1. FULFILLMENT INFO *@
                    <section class="space-y-6">
                        <h3 class="text-xl font-black text-white uppercase italic border-l-4 border-emerald-500 pl-4 tracking-tight">1. Delivery Info</h3>
                        
                        @* Only show toggle if BOTH options are enabled by owner *@
                        @if (owner.OffersPickup && owner.OffersDelivery)
                        {
                            <div class="grid grid-cols-2 gap-4 bg-black p-2 rounded-[2rem] border border-white/5">
                                <button @onclick='() => SetFulfillment("Pickup")' 
                                        class='py-4 rounded-[1.5rem] font-black uppercase text-sm transition-all @(selFulfillment == "Pickup" ? "bg-white text-black shadow-xl" : "text-slate-500 hover:text-slate-300")'>
                                    🏢 Pickup
                                </button>
                                <button @onclick='() => SetFulfillment("Delivery")' 
                                        class='py-4 rounded-[1.5rem] font-black uppercase text-sm transition-all @(selFulfillment == "Delivery" ? "bg-blue-600 text-white shadow-xl" : "text-slate-500 hover:text-slate-300")'>
                                    🚚 Delivery
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 bg-white/5 border border-white/10 rounded-2xl flex items-center gap-3">
                                @if (owner.OffersDelivery) { <span class="text-blue-400 font-black uppercase text-xs">🚚 Delivery Only Provider</span> }
                                else { <span class="text-slate-500 font-black uppercase text-xs">🏢 Pickup Only Provider</span> }
                            </div>
                        }

                        @if (selFulfillment == "Delivery")
                        {
                            <div class="space-y-6 animate-in slide-in-from-top duration-300">
                                <div class="flex flex-col gap-2">
                                    <label class="text-[10px] font-black uppercase text-slate-500 tracking-widest ml-2 font-bold">Select Delivery Address</label>
                                    <select class="w-full bg-black border border-white/10 rounded-2xl p-5 text-white font-bold outline-none focus:border-blue-500 shadow-inner" 
                                            @onchange="OnAddressDropdownChange">
                                        @if (currentUser?.Addresses != null && currentUser.Addresses.Any())
                                        {
                                            @foreach (var addr in currentUser.Addresses)
                                            {
                                                <option value="@addr.Id" selected="@(selectedAddress?.Id == addr.Id)">@addr.Label: @addr.Street</option>
                                            }
                                        }
                                        <option value="new">+ Add New Address...</option>
                                    </select>
                                </div>

                                @if (showNewAddressForm)
                                {
                                    <div class="bg-black/40 border border-white/5 rounded-[2.5rem] p-8 space-y-4 shadow-inner">
                                        <div class="space-y-4">
                                            <div>
                                                <label class="text-[9px] uppercase text-gray-500 ml-2 mb-1 block font-black">Address Label</label>
                                                <input @bind="tempAddress.Label" placeholder="Home, Work, etc." class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl p-4 text-sm text-white outline-none focus:border-blue-500" />
                                            </div>
                                            <div>
                                                <label class="text-[9px] uppercase text-gray-500 ml-2 mb-1 block font-black">Street Address</label>
                                                <input @bind="tempAddress.Street" placeholder="123 Main St" class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl p-4 text-sm text-white outline-none focus:border-blue-500" />
                                            </div>
                                            <div class="grid grid-cols-12 gap-4">
                                                <div class="col-span-6">
                                                    <label class="text-[9px] uppercase text-gray-500 ml-2 mb-1 block font-black">City</label>
                                                    <input @bind="tempAddress.City" placeholder="City" class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl p-4 text-sm text-white outline-none focus:border-blue-500" />
                                                </div>
                                                <div class="col-span-3">
                                                    <label class="text-[9px] uppercase text-gray-500 ml-2 mb-1 block font-black">State</label>
                                                    <input @bind="tempAddress.State" maxlength="2" placeholder="TX" class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl p-4 text-sm text-white outline-none focus:border-blue-500 text-center uppercase" />
                                                </div>
                                                <div class="col-span-3">
                                                    <label class="text-[9px] uppercase text-gray-500 ml-2 mb-1 block font-black">Zip</label>
                                                    <input @bind="tempAddress.ZipCode" @oninput="HandleZipInput" maxlength="5" placeholder="75482" class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl p-4 text-sm text-white outline-none focus:border-blue-500 font-mono text-center" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @{ var feeInfo = GetDeliveryFeeInfo(); }
                                <div class="p-6 rounded-[2rem] flex flex-col md:flex-row justify-between items-center gap-4 @(feeInfo.IsBlocked ? "bg-rose-500/10 border-rose-500/20" : feeInfo.IsOutOfArea ? "bg-amber-500/10 border-amber-500/20" : "bg-blue-600 text-white shadow-xl")">
                                    <div class="text-center md:text-left">
                                        <p class="text-[10px] font-black uppercase tracking-widest @(feeInfo.IsOutOfArea ? "text-amber-500" : "text-blue-200")">@(feeInfo.IsBlocked ? "Blocked" : "Delivery Logistics")</p>
                                        <p class="text-sm font-bold">@feeInfo.Label</p>
                                        @if(currentDistance > 0) { <p class="text-[10px] opacity-70 font-bold italic">Distance: @Math.Round(currentDistance, 1) miles</p> }
                                    </div>
                                    <div class="text-3xl font-black font-mono">$@feeInfo.Fee.ToString("N2")</div>
                                </div>

                                @if (feeInfo.IsOutOfArea && !feeInfo.IsBlocked)
                                {
                                    <div class="p-4 bg-amber-500/10 border border-amber-500/20 rounded-2xl flex items-start gap-4">
                                        <span class="text-xl">⚠️</span>
                                        <p class="text-xs font-bold text-amber-400 leading-tight">Notice: This address is beyond our normal range. The owner may review and cancel this order if fulfillment is not feasible.</p>
                                    </div>
                                }
                                @if (feeInfo.IsBlocked)
                                {
                                    <div class="p-4 bg-rose-500/10 border border-rose-500/20 rounded-2xl flex items-start gap-4">
                                        <span class="text-xl">🚫</span>
                                        <p class="text-xs font-bold text-rose-400 leading-tight">Out of Delivery Range: This address is too far to fulfill. Please choose pickup or a different address.</p>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    @* 2. OPTIONS & PORTIONS *@
                    <section class="space-y-8">
                        <h3 class="text-xl font-black text-white uppercase italic border-l-4 border-emerald-500 pl-4 tracking-tight">2. Options & Portions</h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="space-y-3">
                                <label class="text-[10px] font-black uppercase text-slate-500 tracking-widest ml-2">Time Slot</label>
                                <div class="flex gap-2 p-1.5 bg-black rounded-2xl border border-white/5">
                                    <button @onclick='() => selTime = "Lunch"' class='flex-1 py-3 rounded-xl text-xs font-black uppercase transition-all @(selTime == "Lunch" ? "bg-emerald-500 text-white" : "text-slate-600 hover:text-slate-400")'>Lunch</button>
                                    <button @onclick='() => selTime = "Dinner"' class='flex-1 py-3 rounded-xl text-xs font-black uppercase transition-all @(selTime == "Dinner" ? "bg-emerald-500 text-white" : "text-slate-600 hover:text-slate-400")'>Dinner</button>
                                </div>
                            </div>

                            <div class="space-y-3">
                                <label class="text-[10px] font-black uppercase text-slate-500 tracking-widest ml-2">Size Selection</label>
                                <select @onchange="OnSizeChange" class="w-full bg-black border border-white/10 rounded-2xl p-4 text-white text-sm outline-none font-bold">
                                    @if (item.Sizes != null)
                                    {
                                        @foreach(var size in item.Sizes)
                                        {
                                            <option value="@size.Id" selected="@(selSizeId == size.Id)">
                                                @size.Name (@size.ServingsPerUnit serv) - $@size.BasePrice.ToString("N2")
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="space-y-6">
                            <label class="text-[10px] font-black uppercase text-slate-500 tracking-widest ml-2">Customize Individual Meals</label>
                            
                            @for (int i = 0; i < servingLabels.Count; i++)
                            {
                                int sIdx = i;
                                <div class="p-8 bg-white/[0.02] border border-white/5 rounded-[2.5rem] space-y-6 shadow-sm">
                                    <div class="flex items-center gap-4 border-b border-white/5 pb-4">
                                        <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-500 flex items-center justify-center font-black text-xs">@(sIdx + 1)</div>
                                        <input @bind="servingLabels[sIdx]" class="flex-1 bg-transparent p-2 text-lg font-black text-white outline-none focus:text-emerald-400 transition-colors" placeholder="Name for this meal..." />
                                    </div>

                                    @if (selectedSize?.Options?.Any() == true)
                                    {
                                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                                            @foreach (var opt in selectedSize.Options)
                                            {
                                                bool isSelected = servingOptions[sIdx].Contains(opt.Id);
                                                <button @onclick="() => ToggleOption(sIdx, opt.Id)" 
                                                        class='px-4 py-3 rounded-xl text-[10px] font-black uppercase border transition-all @(isSelected ? "bg-emerald-500 border-emerald-500 text-white" : "bg-black/40 border-white/5 text-slate-500 hover:border-white/20")'>
                                                    @opt.Name (@(opt.AddOnPrice >= 0 ? "+" : "")$@opt.AddOnPrice.ToString("N2"))
                                                </button>
                                            }
                                        </div>
                                    }

                                    @if (owner.AllowCustomServingNotes)
                                    {
                                        <div class="space-y-2 mt-4">
                                            <label class="text-[9px] font-black uppercase text-slate-600 tracking-widest ml-1">Special Instructions</label>
                                            <textarea @bind="servingNotes[sIdx]" maxlength="200"
                                                      class="w-full bg-black/40 border border-white/10 rounded-2xl p-4 text-xs text-slate-300 outline-none focus:border-emerald-500 h-20 resize-none" 
                                                      placeholder="No onions, extra sauce, etc..."></textarea>
                                            <div class="flex justify-end pr-2">
                                                <span class="text-[8px] font-bold text-slate-700 uppercase">@servingNotes[sIdx].Length / 200</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>

                    @* SUMMARY & ADD TO CART *@
                    <div class="pt-8 border-t border-white/10 space-y-6">
                        @{
                            double baseCost = selectedSize?.BasePrice ?? 0;
                            double optionsCost = 0;
                            for(int i = 0; i < servingOptions.Count; i++) {
                                foreach(var optId in servingOptions[i]) {
                                    var match = selectedSize?.Options.FirstOrDefault(o => o.Id == optId);
                                    if(match != null) optionsCost += match.AddOnPrice;
                                }
                            }
                            var fInfo = GetDeliveryFeeInfo();
                            double deliveryCost = selFulfillment == "Delivery" ? fInfo.Fee : 0;
                            double totalCost = baseCost + optionsCost + deliveryCost;
                            bool canAdd = selFulfillment == "Pickup" || (IsAddressValid() && !fInfo.IsBlocked);
                        }
                        
                        <div class="bg-black/50 border border-white/5 rounded-[2.5rem] p-8 space-y-4 shadow-inner">
                            <div class="flex justify-between items-center text-sm font-bold text-slate-400 uppercase tracking-widest">
                                <span>Item Subtotal</span><span>$@baseCost.ToString("N2")</span>
                            </div>
                            @if (optionsCost > 0) {
                                <div class="flex justify-between items-center text-sm font-bold text-emerald-500 uppercase tracking-widest">
                                    <span>Added Options</span><span>+$@optionsCost.ToString("N2")</span>
                                </div>
                            }
                            @if (selFulfillment == "Delivery") {
                                <div class="flex justify-between items-center text-sm font-bold text-blue-400 uppercase tracking-widest">
                                    <span>Delivery Fee</span><span>$@deliveryCost.ToString("N2")</span>
                                </div>
                            }
                            <div class="w-full h-px bg-white/5 my-4"></div>
                            <div class="flex justify-between items-center text-3xl font-black text-white italic">
                                <span class="uppercase tracking-tighter">Total Amount</span><span>$@totalCost.ToString("N2")</span>
                            </div>
                        </div>

                        <button type="button" @onclick="AddToCart" disabled="@(!canAdd)" 
                                class="w-full bg-emerald-600 hover:bg-emerald-500 disabled:opacity-30 disabled:grayscale text-white py-8 rounded-[2rem] font-black text-lg uppercase tracking-[0.4em] shadow-[0_20px_50px_rgba(16,185,129,0.2)] transition-all active:scale-[0.98]">
                            Add to Cart
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int OwnerId { get; set; }
    [Parameter] public int MenuItemId { get; set; }
    
    private PPP_Owner? owner;
    private PPP_MenuItem? item;
    private PPP_User? currentUser;
    private PPP_User? sessionUser;
    private bool isImpersonating = false;

    private string selFulfillment = "Pickup";
    private string selTime = "Dinner";
    private int selSizeId;
    private PPP_MenuItemSize? selectedSize;
    
    private List<string> servingLabels = new();
    private List<HashSet<int>> servingOptions = new();
    private List<string> servingNotes = new();
    
    private PPP_Address? selectedAddress;
    private PPP_Address tempAddress = new() { Label = "" };
    private bool showNewAddressForm = false;
    private double currentDistance = 0;
    private (double Lat, double Lon)? ownerCoords;
    
    private List<PPP_DeliveryZipCode> ownerZips = new();
    private List<PPP_DeliveryRadiusRule> ownerRadiusRules = new();

    protected override async Task OnInitializedAsync() {
        await using var db = await DbFactory.CreateDbContextAsync();
        owner = await db.PPP_Owners.Include(o => o.Address).AsNoTracking().FirstOrDefaultAsync(o => o.Id == OwnerId);
        item = await db.Set<PPP_MenuItem>().Include(i => i.Recipe).Include(i => i.Sizes).ThenInclude(s => s.Options).FirstOrDefaultAsync(i => i.Id == MenuItemId);
        
        if (owner != null) {
            ownerZips = await db.Set<PPP_DeliveryZipCode>().Where(z => z.OwnerId == OwnerId).ToListAsync();
            ownerRadiusRules = await db.Set<PPP_DeliveryRadiusRule>().Where(r => r.OwnerId == OwnerId && r.Enabled).OrderBy(r => r.MaxMiles).ToListAsync();
            if (!owner.OffersPickup && owner.OffersDelivery) selFulfillment = "Delivery";
            else if (owner.OffersPickup && !owner.OffersDelivery) selFulfillment = "Pickup";
            if (owner.Address != null) ownerCoords = await GeoService.GetCoordinatesAsync(owner.Address.Street, owner.Address.City, owner.Address.State, owner.Address.ZipCode);
        }
        if (item?.Sizes?.Any() == true) { selectedSize = item.Sizes.First(); selSizeId = selectedSize.Id; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) { 
            await LoadSessionIdentity(); 
            SyncServingLists();
            if (currentUser?.Addresses?.Any() == true) await SelectAddress(currentUser.Addresses.FirstOrDefault(a => a.IsDefault) ?? currentUser.Addresses.First());
            else showNewAddressForm = true;
            StateHasChanged(); 
        }
    }

    private void SetFulfillment(string f) { selFulfillment = f; StateHasChanged(); }
    private void OnSizeChange(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int id)) { selSizeId = id; selectedSize = item?.Sizes.FirstOrDefault(s => s.Id == id); SyncServingLists(); } }
    private void SyncServingLists() {
        int count = selectedSize?.ServingsPerUnit ?? 1;
        servingLabels = Enumerable.Range(0, count).Select(i => i < servingLabels.Count ? servingLabels[i] : (currentUser?.FirstName ?? "")).ToList();
        servingOptions = Enumerable.Range(0, count).Select(i => i < servingOptions.Count ? servingOptions[i] : new HashSet<int>()).ToList();
        servingNotes = Enumerable.Range(0, count).Select(i => i < servingNotes.Count ? servingNotes[i] : "").ToList();
    }

    private void ToggleOption(int sIdx, int optId) { if (servingOptions[sIdx].Contains(optId)) servingOptions[sIdx].Remove(optId); else servingOptions[sIdx].Add(optId); StateHasChanged(); }

    private async Task OnAddressDropdownChange(ChangeEventArgs e) {
        var val = e.Value?.ToString();
        if (val == "new") { selectedAddress = null; showNewAddressForm = true; currentDistance = 0; } 
        else if (int.TryParse(val, out int id)) { var addr = currentUser?.Addresses.FirstOrDefault(a => a.Id == id); if (addr != null) await SelectAddress(addr); }
    }

    private async Task SelectAddress(PPP_Address addr) { selectedAddress = addr; showNewAddressForm = false; await UpdateDistance(addr.Street, addr.City, addr.State, addr.ZipCode); }
    private async Task HandleZipInput(ChangeEventArgs e) {
        tempAddress.ZipCode = e.Value?.ToString() ?? "";
        if (tempAddress.ZipCode.Length == 5) await UpdateDistance(tempAddress.Street, tempAddress.City, tempAddress.State, tempAddress.ZipCode);
    }

    private bool IsAddressValid() => !showNewAddressForm ? selectedAddress != null : !string.IsNullOrWhiteSpace(tempAddress.Street) && !string.IsNullOrWhiteSpace(tempAddress.ZipCode);

    private async Task UpdateDistance(string s, string c, string st, string z) {
        if (ownerCoords.HasValue && !string.IsNullOrEmpty(z)) {
            var coords = await GeoService.GetCoordinatesAsync(s, c, st, z);
            if (coords.HasValue) currentDistance = GeoService.CalculateDistance(ownerCoords.Value.Lat, ownerCoords.Value.Lon, coords.Value.Lat, coords.Value.Lon);
        }
        StateHasChanged();
    }

    private (double Fee, bool IsOutOfArea, bool IsBlocked, string Label) GetDeliveryFeeInfo() {
        var zip = selectedAddress?.ZipCode ?? tempAddress.ZipCode;
        if (string.IsNullOrWhiteSpace(zip)) return (0, false, false, "Ready to Calculate");
        var zipMatch = ownerZips.FirstOrDefault(z => z.ZipCode == zip.Trim());
        if (zipMatch != null) return (zipMatch.Fee, false, false, "Verified Zip Delivery");
        var radiusMatch = ownerRadiusRules.FirstOrDefault(r => currentDistance <= r.MaxMiles);
        if (radiusMatch != null) return (radiusMatch.Fee, false, false, $"Radius Level ({radiusMatch.MaxMiles}mi)");
        double maxRadius = ownerRadiusRules.Any() ? ownerRadiusRules.Max(r => r.MaxMiles) : 0;
        double defaultFee = ownerRadiusRules.Any() ? ownerRadiusRules.MaxBy(r => r.MaxMiles)!.Fee : 10.00;
        if (currentDistance <= maxRadius * 2) return (defaultFee, true, false, "Extended Range (Manual Review)");
        return (0, true, true, "Outside Service Area");
    }

    private async Task LoadSessionIdentity() {
        try {
            var token = await JS.InvokeAsync<string>("eval", "document.cookie.split('; ').find(row => row.startsWith('ppp_token='))?.split('=')[1]");
            if (!string.IsNullOrEmpty(token)) {
                await using var db = await DbFactory.CreateDbContextAsync();
                sessionUser = await db.PPP_Users.Include(u => u.Addresses).FirstOrDefaultAsync(u => u.MagicToken == token && u.TokenExpiresAt > DateTime.UtcNow);
                if (sessionUser != null) {
                    if (!string.IsNullOrEmpty(sessionUser.ImpersonatingEmail)) { currentUser = await db.PPP_Users.Include(u => u.Addresses).FirstOrDefaultAsync(u => u.Email == sessionUser.ImpersonatingEmail); isImpersonating = true; }
                    else { currentUser = sessionUser; isImpersonating = false; }
                }
            }
        } catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    private async Task EndImpersonation() {
        if (sessionUser != null) {
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbUser = await db.PPP_Users.FindAsync(sessionUser.Id);
            if (dbUser != null) { dbUser.ImpersonatingEmail = null; await db.SaveChangesAsync(); Nav.NavigateTo(Nav.Uri, forceLoad: true); }
        }
    }

    private void AddToCart() {
        double totalOptions = 0;
        for(int i = 0; i < servingOptions.Count; i++) {
            foreach(var optId in servingOptions[i]) { totalOptions += selectedSize?.Options.FirstOrDefault(o => o.Id == optId)?.AddOnPrice ?? 0; }
        }
        var feeInfo = GetDeliveryFeeInfo();
        string addrText = selFulfillment == "Pickup" ? "🏢 Pickup at Store" : 
                         (selectedAddress != null ? $"{selectedAddress.Label}: {selectedAddress.Street}" : $"{tempAddress.Street}, {tempAddress.City}");

        var newItem = new CartItem {
            MenuItemId = item!.Id, RecipeName = item.Recipe?.Name ?? "Item", ImageId = item.Recipe?.ImageId?.ToString(),
            SizeId = selSizeId, SizeName = selectedSize?.Name ?? "", Price = (selectedSize?.BasePrice ?? 0) + totalOptions,
            Fulfillment = selFulfillment, TimeSlot = selTime, DeliveryFee = selFulfillment == "Delivery" ? feeInfo.Fee : 0,
            CalculatedDistance = currentDistance, DeliveryAddressSummary = addrText
        };
        for (int i = 0; i < servingLabels.Count; i++) {
            newItem.Servings.Add(new ServingConfig {
                Label = servingLabels[i], Notes = owner!.AllowCustomServingNotes ? servingNotes[i] : "",
                SelectedOptionNames = selectedSize?.Options.Where(o => servingOptions[i].Contains(o.Id)).Select(o => o.Name).ToList() ?? new(),
                SelectedOptionPrices = selectedSize?.Options.Where(o => servingOptions[i].Contains(o.Id)).Select(o => o.AddOnPrice).ToList() ?? new()
            });
        }
        CartService.AddToCart(newItem);
        Nav.NavigateTo($"/ppp-store/{OwnerId}");
    }

    private void GoBack() => Nav.NavigateTo($"/ppp-store/{OwnerId}");
}