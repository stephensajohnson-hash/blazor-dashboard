@page "/ppp-store/{OwnerId:int}/item/{MenuItemId:int}"
@using Dashboard
@using Dashboard.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject GeocodingService GeoService

<div class="min-h-screen w-full bg-[#050505] text-slate-200 font-sans antialiased">
    @if (owner != null && item != null)
    {
        @* STICKY HEADER *@
        <div class="sticky top-0 z-[100] bg-[#050505]/80 backdrop-blur-xl border-b border-white/10 px-8 py-6">
            <header class="flex flex-row justify-between items-center gap-6">
                
                <div class="cursor-pointer group" @onclick="GoBack">
                    <h1 class="text-4xl font-black uppercase italic tracking-tighter text-white group-hover:text-emerald-500 transition-colors">
                        @owner.BusinessName
                    </h1>
                    <p class="text-emerald-500 uppercase tracking-widest text-sm mt-2 font-bold flex items-center gap-2">
                        <span class="text-xl">←</span> Back to Menu
                    </p>
                </div>
                
                <div class="flex items-center gap-6 ml-auto">
                    @if (currentUser != null)
                    {
                        <div class="relative group">
                            <div class="flex items-center gap-4 bg-white/5 p-2 pr-6 rounded-full border border-white/10 cursor-pointer hover:bg-white/10 transition-all">
                                <div class="w-10 h-10 rounded-full overflow-hidden border border-white/10 shrink-0 bg-emerald-600 flex items-center justify-center font-black text-white">
                                    @if (currentUser.AvatarId.HasValue)
                                    {
                                        <img src="/db-images-ppp/@currentUser.AvatarId" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <span>@currentUser.FirstName?[0]@currentUser.LastName?[0]</span>
                                    }
                                </div>
                                <div class="flex flex-col leading-tight">
                                    <span class="text-sm font-black uppercase text-white">@currentUser.FirstName @currentUser.LastName</span>
                                    @if (isImpersonating)
                                    {
                                        <span class="text-[10px] font-black uppercase text-amber-500 animate-pulse">🕵️ Impersonating</span>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] font-black uppercase text-slate-500 font-bold">Customer</span>
                                    }
                                </div>
                            </div>

                            @* Dropdown Content *@
                            <div class="absolute right-0 mt-2 w-64 bg-[#111] border border-white/10 rounded-2xl shadow-2xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-[110]">
                                <div class="px-4 py-3 border-b border-white/5 mb-2">
                                    <p class="text-[10px] font-black text-slate-500 uppercase">Logged in as</p>
                                    <p class="text-xs font-bold text-white truncate">@currentUser.Email</p>
                                </div>
                                @if (isImpersonating)
                                {
                                    <button @onclick="EndImpersonation" class="w-full text-left px-4 py-3 text-xs font-black uppercase text-rose-500 hover:bg-rose-500/10 transition-colors flex items-center gap-3">
                                        <span>🚫</span> Stop Impersonating
                                    </button>
                                }
                                <button class="w-full text-left px-4 py-3 text-xs font-black uppercase text-slate-400 hover:bg-white/5 transition-colors">
                                    Logout
                                </button>
                            </div>
                        </div>
                    }

                    <div class="bg-emerald-500/10 border border-emerald-500/20 px-6 py-3 rounded-2xl flex items-center gap-4">
                        <span class="text-2xl">🛒</span>
                        <div class="flex flex-col">
                            <span class="text-[10px] font-black uppercase text-emerald-500 tracking-widest font-bold">Your Cart</span>
                            <span class="text-sm font-bold text-white">0 Items</span>
                        </div>
                    </div>
                </div>
            </header>
        </div>

        <div class="p-8 max-w-4xl mx-auto space-y-8 pb-40">
            <div class="bg-[#111] border border-slate-800 rounded-[3rem] overflow-hidden shadow-2xl">
                
                @* HERO SECTION *@
                <div class="p-12 border-b border-white/5 bg-gradient-to-b from-white/[0.02] to-transparent flex flex-col md:flex-row gap-10">
                    @if (item.Recipe?.ImageId != null)
                    {
                        <div class="w-64 h-64 rounded-[2rem] overflow-hidden bg-black shadow-2xl border border-white/10 shrink-0">
                            <img src="/db-images-ppp/@item.Recipe.ImageId" class="w-full h-full object-cover" />
                        </div>
                    }
                    <div class="flex-1">
                        <span class="text-[10px] font-black uppercase text-emerald-500 tracking-[0.4em] font-bold">Customizing Item</span>
                        <h2 class="text-5xl font-black text-white uppercase italic tracking-tighter mt-2">@item.Recipe?.Name</h2>
                        <p class="text-lg text-slate-300 leading-relaxed font-medium mt-6">@item.Recipe?.LongDescription</p>
                    </div>
                </div>

                <div class="p-12 space-y-12">
                    
                    @* FULFILLMENT SECTION *@
                    <section class="space-y-6">
                        <h3 class="text-xl font-black text-white uppercase italic tracking-tight border-l-4 border-emerald-500 pl-4">1. Delivery Info</h3>
                        
                        @if (owner.OffersPickup && owner.OffersDelivery)
                        {
                            <div class="grid grid-cols-2 gap-4 bg-black p-2 rounded-[2rem] border border-white/5">
                                <button @onclick='() => selFulfillment = "Pickup"' 
                                        class='py-4 rounded-[1.5rem] font-black uppercase text-sm transition-all @(selFulfillment == "Pickup" ? "bg-white text-black shadow-xl" : "text-slate-500 hover:text-slate-300")'>
                                    🏢 Pickup
                                </button>
                                <button @onclick='() => selFulfillment = "Delivery"' 
                                        class='py-4 rounded-[1.5rem] font-black uppercase text-sm transition-all @(selFulfillment == "Delivery" ? "bg-blue-600 text-white shadow-xl" : "text-slate-500 hover:text-slate-300")'>
                                    🚚 Delivery
                                </button>
                            </div>
                        }

                        @if (selFulfillment == "Delivery")
                        {
                            <div class="space-y-6 animate-in slide-in-from-top duration-300">
                                
                                @* Address Dropdown *@
                                <div class="flex flex-col gap-2">
                                    <label class="text-[10px] font-black uppercase text-slate-500 tracking-widest ml-2 font-bold">Select Delivery Address</label>
                                    <select class="w-full bg-black border border-white/10 rounded-2xl p-5 text-white outline-none focus:border-blue-500 text-base font-bold shadow-inner" 
                                            @onchange="OnAddressDropdownChange">
                                        @if (currentUser?.Addresses != null && currentUser.Addresses.Any())
                                        {
                                            @foreach (var addr in currentUser.Addresses)
                                            {
                                                <option value="@addr.Id" selected="@(selectedAddress?.Id == addr.Id)">
                                                    @addr.Label: @addr.Street, @addr.City
                                                </option>
                                            }
                                        }
                                        <option value="new">+ Add New Address...</option>
                                    </select>
                                </div>

                                @* New Address Form *@
                                @if (showNewAddressForm)
                                {
                                    <div class="bg-black/40 border border-white/5 rounded-[2.5rem] p-8 space-y-4 shadow-inner">
                                        <div class="grid grid-cols-2 gap-4">
                                            <input @bind="tempAddress.Label" placeholder="Label (Home, Office)" class="bg-[#0a0a0a] border border-white/10 rounded-xl p-4 text-sm text-white outline-none focus:border-blue-500" />
                                            <input @bind="tempAddress.Street" placeholder="Street Address" class="bg-[#0a0a0a] border border-white/10 rounded-xl p-4 text-sm text-white outline-none focus:border-blue-500" />
                                        </div>
                                        
                                        <input @bind="tempAddress.City" placeholder="City" class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl p-4 text-sm text-white outline-none focus:border-blue-500" />
                                        
                                        <div class="grid grid-cols-2 gap-4">
                                            <input @bind="tempAddress.State" maxlength="2" placeholder="State" class="bg-[#0a0a0a] border border-white/10 rounded-xl p-4 text-sm text-white outline-none focus:border-blue-500" />
                                            <input @bind="tempAddress.ZipCode" @oninput="HandleZipInput" maxlength="5" placeholder="Zip Code" class="bg-[#0a0a0a] border border-white/10 rounded-xl p-4 text-sm text-white outline-none focus:border-blue-500 font-mono" />
                                        </div>
                                    </div>
                                }

                                @* Fee Calculation Badge *@
                                @{ var feeInfo = GetDeliveryFeeInfo(); }
                                <div class="p-6 rounded-[2rem] flex flex-col md:flex-row justify-between items-center gap-4 @(feeInfo.IsOutOfArea ? "bg-amber-500/10 border-2 border-amber-500/20" : "bg-blue-600 text-white shadow-xl")">
                                    <div class="text-center md:text-left">
                                        <p class="text-[10px] font-black uppercase @(feeInfo.IsOutOfArea ? "text-amber-500" : "text-blue-200") tracking-widest">Delivery Logistics</p>
                                        <p class="text-sm font-bold">@feeInfo.Label</p>
                                        @if(currentDistance > 0)
                                        {
                                            <p class="text-[10px] opacity-70 font-bold">Distance: @Math.Round(currentDistance, 1) miles</p>
                                        }
                                    </div>
                                    <div class="text-3xl font-black font-mono">$@feeInfo.Fee.ToString("N2")</div>
                                </div>
                                
                                @if (feeInfo.IsOutOfArea)
                                {
                                    <div class="p-5 bg-rose-500/10 border border-rose-500/20 rounded-2xl flex items-start gap-4">
                                        <span class="text-2xl">⚠️</span>
                                        <p class="text-sm font-bold text-rose-400 leading-tight">
                                            Notice: This location is outside our standard area. Manual review is required. 
                                            The owner may contact you to adjust the fee or cancel if the distance is prohibitive.
                                        </p>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    @* PREFERENCES SECTION *@
                    <section class="space-y-8">
                        <h3 class="text-xl font-black text-white uppercase italic tracking-tight border-l-4 border-emerald-500 pl-4">2. Options & Portions</h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            
                            @* Time Slot *@
                            <div class="space-y-3">
                                <label class="text-[10px] font-black uppercase text-slate-500 tracking-widest ml-2">Time Slot</label>
                                <div class="flex gap-2 p-1.5 bg-black rounded-2xl border border-white/5">
                                    <button @onclick='() => selTime = "Lunch"' 
                                            class='flex-1 py-3 rounded-xl text-xs font-black uppercase transition-all @(selTime == "Lunch" ? "bg-emerald-500 text-white" : "text-slate-600 hover:text-slate-400")'>
                                        Lunch
                                    </button>
                                    <button @onclick='() => selTime = "Dinner"' 
                                            class='flex-1 py-3 rounded-xl text-xs font-black uppercase transition-all @(selTime == "Dinner" ? "bg-emerald-500 text-white" : "text-slate-600 hover:text-slate-400")'>
                                        Dinner
                                    </button>
                                </div>
                            </div>

                            @* Size Selection *@
                            <div class="space-y-3">
                                <label class="text-[10px] font-black uppercase text-slate-500 tracking-widest ml-2">Size Selection</label>
                                <select @onchange="OnSizeChange" class="w-full bg-black border border-white/10 rounded-2xl p-4 text-white text-sm outline-none">
                                    @if (item.Sizes != null)
                                    {
                                        @foreach(var size in item.Sizes)
                                        {
                                            <option value="@size.Id" selected="@(selSizeId == size.Id)">
                                                @size.Name (@size.ServingsPerUnit serv)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        @* Dynamic Serving Configurator *@
                        <div class="space-y-6">
                            <label class="text-[10px] font-black uppercase text-slate-500 tracking-widest ml-2">Customize Individual Meals</label>
                            
                            @for (int i = 0; i < servingLabels.Count; i++)
                            {
                                int sIdx = i; // Local copy for the lambda closures
                                
                                <div class="p-8 bg-white/[0.02] border border-white/5 rounded-[2.5rem] space-y-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-500 flex items-center justify-center font-black text-xs">
                                            @(sIdx + 1)
                                        </div>
                                        <input @bind="servingLabels[sIdx]" 
                                               class="flex-1 bg-transparent border-b border-white/10 p-2 text-base font-bold text-white outline-none focus:border-emerald-500" 
                                               placeholder="Name for this meal..." />
                                    </div>

                                    @if (selectedSize?.Options?.Any() == true)
                                    {
                                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-4">
                                            @foreach (var opt in selectedSize.Options)
                                            {
                                                bool isSelected = servingOptions[sIdx].Contains(opt.Id);
                                                
                                                <button @onclick="() => ToggleOption(sIdx, opt.Id)" 
                                                        class='px-4 py-3 rounded-xl text-[10px] font-black uppercase border transition-all @(isSelected ? "bg-emerald-500 border-emerald-500 text-white" : "bg-black/40 border-white/5 text-slate-500 hover:border-white/20")'>
                                                    @opt.Name
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>

                    @* Submit Button *@
                    <button type="button" 
                            @onclick="SimulateAddToCart" 
                            disabled="@(selFulfillment == "Delivery" && !IsAddressValid())" 
                            class="w-full bg-emerald-600 hover:bg-emerald-500 disabled:opacity-30 disabled:grayscale text-white py-8 rounded-[2.5rem] font-black text-lg uppercase tracking-[0.4em] shadow-[0_20px_50px_rgba(16,185,129,0.2)] transition-all active:scale-[0.98]">
                        Add to Cart & Continue
                    </button>

                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int OwnerId { get; set; }
    [Parameter] public int MenuItemId { get; set; }
    
    private PPP_Owner? owner;
    private PPP_MenuItem? item;
    
    // Identity Context
    private PPP_User? currentUser;
    private PPP_User? sessionUser;
    private bool isImpersonating = false;

    // Configuration State
    private string selFulfillment = "Pickup";
    private string selTime = "Dinner";
    private int selSizeId;
    private PPP_MenuItemSize? selectedSize;
    
    // Servings Data
    private List<string> servingLabels = new();
    private List<HashSet<int>> servingOptions = new();
    
    // Delivery State
    private PPP_Address? selectedAddress;
    private PPP_Address tempAddress = new() { Label = "" };
    private bool showNewAddressForm = false;
    private double currentDistance = 0;
    private (double Lat, double Lon)? ownerCoords;
    
    private List<PPP_DeliveryZipCode> ownerZips = new();
    private List<PPP_DeliveryRadiusRule> ownerRadiusRules = new();

    protected override async Task OnInitializedAsync() 
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        
        owner = await db.PPP_Owners
            .Include(o => o.Address)
            .AsNoTracking()
            .FirstOrDefaultAsync(o => o.Id == OwnerId);
            
        item = await db.Set<PPP_MenuItem>()
            .Include(i => i.Recipe)
            .Include(i => i.Sizes).ThenInclude(s => s.Options)
            .Include(i => i.Timeframes)
            .FirstOrDefaultAsync(i => i.Id == MenuItemId);
        
        if (owner != null)
        {
            ownerZips = await db.Set<PPP_DeliveryZipCode>().Where(z => z.OwnerId == OwnerId).ToListAsync();
            ownerRadiusRules = await db.Set<PPP_DeliveryRadiusRule>().Where(r => r.OwnerId == OwnerId && r.Enabled).OrderBy(r => r.MaxMiles).ToListAsync();
            
            if (!owner.OffersPickup && owner.OffersDelivery)
            {
                selFulfillment = "Delivery";
            }
            
            if (owner.Address != null)
            {
                ownerCoords = await GeoService.GetCoordinatesAsync(owner.Address.Street, owner.Address.City, owner.Address.State, owner.Address.ZipCode);
            }
        }
        
        if (item?.Sizes?.Any() == true) 
        {
            selectedSize = item.Sizes.First();
            selSizeId = selectedSize.Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) 
    {
        if (firstRender) 
        {
            await LoadSessionIdentity(); 
            SyncServingLists();
            
            if (currentUser?.Addresses?.Any() == true)
            {
                await SelectAddress(currentUser.Addresses.FirstOrDefault(a => a.IsDefault) ?? currentUser.Addresses.First());
            }
            else 
            {
                showNewAddressForm = true;
            }
            
            StateHasChanged(); 
        }
    }

    private void OnSizeChange(ChangeEventArgs e) 
    {
        if (int.TryParse(e.Value?.ToString(), out int id)) 
        {
            selSizeId = id;
            selectedSize = item?.Sizes.FirstOrDefault(s => s.Id == id);
            SyncServingLists();
        }
    }

    private void SyncServingLists() 
    {
        int count = selectedSize?.ServingsPerUnit ?? 1;
        
        var newLabels = new List<string>();
        var newOptions = new List<HashSet<int>>();

        for (int i = 0; i < count; i++)
        {
            if (i < servingLabels.Count)
            {
                newLabels.Add(servingLabels[i]);
            }
            else
            {
                newLabels.Add(currentUser?.FirstName ?? "");
            }

            if (i < servingOptions.Count)
            {
                newOptions.Add(servingOptions[i]);
            }
            else
            {
                newOptions.Add(new HashSet<int>());
            }
        }

        servingLabels = newLabels;
        servingOptions = newOptions;
    }

    private void ToggleOption(int servingIndex, int optionId) 
    {
        if (servingOptions[servingIndex].Contains(optionId))
        {
            servingOptions[servingIndex].Remove(optionId);
        }
        else
        {
            servingOptions[servingIndex].Add(optionId);
        }
    }

    private async Task OnAddressDropdownChange(ChangeEventArgs e) 
    {
        var val = e.Value?.ToString();
        
        if (val == "new") 
        {
            AddNewAddressMode();
        }
        else if (int.TryParse(val, out int id)) 
        {
            var addr = currentUser?.Addresses.FirstOrDefault(a => a.Id == id);
            if (addr != null)
            {
                await SelectAddress(addr);
            }
        }
    }

    private async Task SelectAddress(PPP_Address addr) 
    {
        selectedAddress = addr;
        showNewAddressForm = false;
        await UpdateDistance(addr.Street, addr.City, addr.State, addr.ZipCode);
    }

    private void AddNewAddressMode() 
    {
        selectedAddress = null;
        showNewAddressForm = true;
        currentDistance = 0;
    }

    private async Task HandleZipInput(ChangeEventArgs e) 
    {
        tempAddress.ZipCode = e.Value?.ToString() ?? "";
        if (tempAddress.ZipCode.Length == 5)
        {
            await UpdateDistance(tempAddress.Street, tempAddress.City, tempAddress.State, tempAddress.ZipCode);
        }
    }

    private bool IsAddressValid() 
    {
        if (!showNewAddressForm && selectedAddress != null)
        {
            return true;
        }
        
        if (showNewAddressForm && !string.IsNullOrWhiteSpace(tempAddress.Label) && !string.IsNullOrWhiteSpace(tempAddress.Street) && !string.IsNullOrWhiteSpace(tempAddress.ZipCode))
        {
            return true;
        }
        
        return false;
    }

    private async Task UpdateDistance(string s, string c, string st, string z) 
    {
        if (ownerCoords.HasValue && !string.IsNullOrEmpty(z)) 
        {
            var coords = await GeoService.GetCoordinatesAsync(s, c, st, z);
            if (coords.HasValue) 
            {
                currentDistance = GeoService.CalculateDistance(ownerCoords.Value.Lat, ownerCoords.Value.Lon, coords.Value.Lat, coords.Value.Lon);
            }
        }
    }

    private (double Fee, bool IsOutOfArea, string Label) GetDeliveryFeeInfo() 
    {
        var zip = selectedAddress?.ZipCode ?? tempAddress.ZipCode;
        
        if (string.IsNullOrWhiteSpace(zip))
        {
            return (0, false, "Ready to Calculate");
        }
        
        var zipMatch = ownerZips.FirstOrDefault(z => z.ZipCode == zip.Trim());
        if (zipMatch != null)
        {
            return (zipMatch.Fee, false, "Verified Zip Delivery");
        }
        
        var radiusMatch = ownerRadiusRules.FirstOrDefault(r => currentDistance <= r.MaxMiles);
        if (radiusMatch != null)
        {
            return (radiusMatch.Fee, false, $"Radius Delivery ({radiusMatch.MaxMiles}mi)");
        }
        
        double defaultFee = ownerRadiusRules.OrderByDescending(r => r.MaxMiles).FirstOrDefault()?.Fee ?? 10.00;
        return (defaultFee, true, "Out of Normal Area");
    }

    private async Task LoadSessionIdentity() 
    {
        try 
        {
            var token = await JS.InvokeAsync<string>("eval", "document.cookie.split('; ').find(row => row.startsWith('ppp_token='))?.split('=')[1]");
            if (!string.IsNullOrEmpty(token)) 
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                sessionUser = await db.PPP_Users
                    .Include(u => u.Addresses)
                    .FirstOrDefaultAsync(u => u.MagicToken == token && u.TokenExpiresAt > DateTime.UtcNow);
                
                if (sessionUser != null) 
                {
                    if (!string.IsNullOrEmpty(sessionUser.ImpersonatingEmail)) 
                    {
                        currentUser = await db.PPP_Users
                            .Include(u => u.Addresses)
                            .FirstOrDefaultAsync(u => u.Email == sessionUser.ImpersonatingEmail);
                        isImpersonating = true;
                    }
                    else 
                    {
                        currentUser = sessionUser;
                        isImpersonating = false;
                    }
                }
            }
        } 
        catch (Exception ex) 
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task EndImpersonation() 
    {
        if (sessionUser != null) 
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbUser = await db.PPP_Users.FindAsync(sessionUser.Id);
            
            if (dbUser != null) 
            {
                dbUser.ImpersonatingEmail = null;
                await db.SaveChangesAsync();
                Nav.NavigateTo(Nav.Uri, forceLoad: true);
            }
        }
    }

    private void GoBack() 
    {
        Nav.NavigateTo($"/ppp-store/{OwnerId}");
    }
    
    private void SimulateAddToCart() 
    {
        Nav.NavigateTo($"/ppp-store/{OwnerId}");
    }
}