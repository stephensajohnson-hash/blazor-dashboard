@page "/ppp-store/{OwnerId:int}/item/{MenuItemId:int}"
@using Dashboard
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<div class="min-h-screen w-full bg-[#050505] text-slate-200 p-8 font-sans">
    <button @onclick="GoBack" class="mb-8 text-sm font-black uppercase text-emerald-500 hover:text-emerald-400 flex items-center gap-2">
        ← Back to Store
    </button>

    @if (item != null)
    {
        <div class="max-w-2xl mx-auto bg-[#111] border border-slate-800 rounded-[3rem] p-12 shadow-2xl">
            <h1 class="text-4xl font-black text-white uppercase italic mb-4">@item.Recipe?.Name</h1>
            <p class="text-lg text-slate-400 mb-12">Select your options below (Coming Soon)</p>

            <button @onclick="SimulateAddToCart" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-6 rounded-3xl font-black text-sm uppercase tracking-[0.4em] shadow-xl transition-all active:scale-95">
                Add to Cart & Continue
            </button>
        </div>
    }
    else
    {
        <p class="text-center text-slate-500 font-black uppercase">Loading Item...</p>
    }
</div>

@code {
    [Parameter] public int OwnerId { get; set; }
    [Parameter] public int MenuItemId { get; set; }
    private PPP_MenuItem? item;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        item = await db.Set<PPP_MenuItem>()
            .Include(i => i.Recipe)
            .FirstOrDefaultAsync(i => i.Id == MenuItemId);
    }

    private void SimulateAddToCart()
    {
        // We will add real logic here later
        Nav.NavigateTo($"/ppp-store/{OwnerId}");
    }

    private void GoBack()
    {
        Nav.NavigateTo($"/ppp-store/{OwnerId}");
    }
}