@page "/ppp-store/{OwnerId:int}/item/{MenuItemId:int}"
@using Dashboard
@using Microsoft.EntityFrameworkCore
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<div class="min-h-screen w-full bg-[#050505] text-slate-200 p-8 font-sans">
    
    @* Back Button *@
    <div class="max-w-2xl mx-auto mb-6">
        <button type="button" @onclick="GoBack" class="text-sm font-black uppercase text-emerald-500 hover:text-emerald-400 flex items-center gap-2 transition-all">
            <span class="text-xl">←</span> Back to Store
        </button>
    </div>

    @if (item != null)
    {
        <div class="max-w-2xl mx-auto bg-[#111] border border-slate-800 rounded-[3rem] p-12 shadow-2xl animate-in fade-in zoom-in duration-300">
            <div class="mb-8">
                <span class="text-[10px] font-black uppercase text-emerald-500 tracking-[0.3em]">Customizing Selection</span>
                <h1 class="text-4xl font-black text-white uppercase italic tracking-tighter mt-2">@item.Recipe?.Name</h1>
            </div>

            <div class="space-y-8 mb-12">
                <div class="p-6 bg-white/5 border border-white/5 rounded-2xl">
                    <p class="text-sm text-slate-400 leading-relaxed">
                        @item.Recipe?.LongDescription
                    </p>
                </div>
                
                <div class="border-2 border-dashed border-white/10 rounded-3xl p-8 text-center">
                    <p class="text-xs font-black uppercase text-slate-600 tracking-widest">Personalization Options Coming Soon</p>
                </div>
            </div>

            <button type="button" @onclick="SimulateAddToCart" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-6 rounded-3xl font-black text-sm uppercase tracking-[0.4em] shadow-[0_0_40px_rgba(16,185,129,0.2)] transition-all active:scale-95">
                Add to Cart & Continue
            </button>
        </div>
    }
    else
    {
        <div class="flex flex-col items-center justify-center h-64 gap-4">
            <div class="w-8 h-8 border-4 border-emerald-500/20 border-t-emerald-500 rounded-full animate-spin"></div>
            <p class="text-slate-500 font-black uppercase text-xs tracking-widest">Loading Item Details...</p>
        </div>
    }
</div>

@code {
    [Parameter] public int OwnerId { get; set; }
    [Parameter] public int MenuItemId { get; set; }
    private PPP_MenuItem? item;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            item = await db.Set<PPP_MenuItem>()
                .Include(i => i.Recipe)
                .FirstOrDefaultAsync(i => i.Id == MenuItemId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading item: {ex.Message}");
        }
    }

    private void SimulateAddToCart()
    {
        Console.WriteLine("Navigating back via Add to Cart");
        Nav.NavigateTo($"/ppp-store/{OwnerId}");
    }

    private void GoBack()
    {
        Console.WriteLine("Navigating back via Back button");
        Nav.NavigateTo($"/ppp-store/{OwnerId}");
    }
}