@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@inject IDbContextFactory<Dashboard.AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (isImpersonating)
{
    <div class="fixed bottom-10 left-10 z-[9999] flex flex-col gap-4 items-start">
        <button @onclick="RemoveMask" class="bg-rose-600 hover:bg-rose-500 text-white px-6 py-4 rounded-2xl shadow-[0_0_40px_rgba(225,29,72,0.4)] border-2 border-white/20 flex items-center gap-4 transition-all active:scale-95 group">
            <span class="text-2xl group-hover:rotate-[-15deg] transition-transform">🔙</span>
            <div class="text-left">
                <p class="text-[9px] font-black uppercase tracking-[0.2em] leading-none opacity-60 mb-1">Testing Mode</p>
                <p class="text-xs font-black uppercase leading-tight">Exit Impersonation</p>
            </div>
        </button>
    </div>
}

@code {
    private bool isImpersonating = false;
    private string? currentToken;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            currentToken = await JS.InvokeAsync<string>("eval", "document.cookie.split('; ').find(row => row.startsWith('ppp_token='))?.split('=')[1]");
            if (!string.IsNullOrEmpty(currentToken))
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var user = await db.PPP_Users.AsNoTracking().FirstOrDefaultAsync(u => u.MagicToken == currentToken);
                
                isImpersonating = !string.IsNullOrEmpty(user?.ImpersonatingEmail);
                if (isImpersonating) await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RemoveMask()
    {
        if (!string.IsNullOrEmpty(currentToken))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.PPP_Users.FirstOrDefaultAsync(u => u.MagicToken == currentToken);
            if (user != null)
            {
                user.ImpersonatingEmail = null; // Take off the mask
                await db.SaveChangesAsync();
            }
        }
        
        Nav.NavigateTo("/ppp-admin/impersonator", forceLoad: true);
    }
}