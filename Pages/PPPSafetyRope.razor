@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (hasBackdoor)
{
    <div class="fixed bottom-10 left-10 z-[9999] flex flex-col gap-4 items-start">
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="bg-emerald-600 text-white px-6 py-3 rounded-2xl shadow-2xl border border-emerald-400/30 animate-in slide-in-from-left duration-300">
                <div class="flex items-center gap-3">
                    <span class="animate-spin">🔄</span>
                    <span class="text-[10px] font-black uppercase tracking-widest">@statusMessage</span>
                </div>
            </div>
        }

        <button @onclick="RestoreAdmin" 
                disabled="@isProcessing"
                class="bg-rose-600 hover:bg-rose-500 disabled:opacity-50 text-white px-6 py-4 rounded-2xl shadow-[0_0_40px_rgba(225,29,72,0.4)] border-2 border-white/20 flex items-center gap-4 transition-all active:scale-95 group">
            <span class="text-2xl group-hover:rotate-[-15deg] transition-transform">🔙</span>
            <div class="text-left">
                <p class="text-[9px] font-black uppercase tracking-[0.2em] leading-none opacity-60 mb-1">Testing Mode</p>
                <p class="text-xs font-black uppercase leading-tight">Exit Impersonation</p>
            </div>
        </button>
    </div>
}

@code {
    private bool hasBackdoor = false;
    private bool isProcessing = false;
    private string statusMessage = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Explicitly check for the backdoor identity
            var backdoor = await JS.InvokeAsync<string>("eval", @"
                (function() {
                    var name = 'ppp_admin_backdoor=';
                    var ca = document.cookie.split(';');
                    for(var i = 0; i < ca.length; i++) {
                        var c = ca[i].trim();
                        if (c.indexOf(name) == 0) return c.substring(name.length, c.length);
                    }
                    return null;
                })()");

            hasBackdoor = !string.IsNullOrEmpty(backdoor);
            if (hasBackdoor) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RestoreAdmin()
    {
        if (isProcessing) return;
        isProcessing = true;
        statusMessage = "Restoring Admin Identity...";
        StateHasChanged();

        // 1. Get the real admin token we stored earlier
        var tokenToRestore = await JS.InvokeAsync<string>("eval", @"
            (function() {
                var name = 'ppp_admin_backdoor=';
                var ca = document.cookie.split(';');
                for(var i = 0; i < ca.length; i++) {
                    var c = ca[i].trim();
                    if (c.indexOf(name) == 0) return c.substring(name.length, c.length);
                }
                return null;
            })()");

        // Fallback only if the cookie was somehow eaten by the browser
        if (string.IsNullOrEmpty(tokenToRestore)) tokenToRestore = "RESCUE_ADMIN_2026";

        // 2. NUCLEAR WIPE (JS)
        await JS.InvokeVoidAsync("eval", @"
            (function(adminKey) {
                // Wipe ppp_token from ALL paths
                document.cookie = 'ppp_token=; max-age=0; path=/;';
                document.cookie = 'ppp_token=; max-age=0; path=' + window.location.pathname + ';';
                
                // Wipe backdoor
                document.cookie = 'ppp_admin_backdoor=; max-age=0; path=/;';
                
                // Re-inject Admin at Root
                document.cookie = 'ppp_token=' + adminKey + '; max-age=15552000; path=/; SameSite=Lax';
            })('" + tokenToRestore + "')");
        
        await Task.Delay(600);
        Nav.NavigateTo("/ppp-admin/impersonator", forceLoad: true);
    }
}