@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (hasBackdoor)
{
    <div class="fixed bottom-10 left-10 z-[9999]">
        <button @onclick="RestoreAdmin" 
                class="bg-rose-600 hover:bg-rose-500 text-white px-6 py-4 rounded-2xl shadow-[0_0_30px_rgba(225,29,72,0.4)] border-2 border-white/20 flex items-center gap-4 transition-all active:scale-95 group">
            <span class="text-2xl group-hover:rotate-[-15deg] transition-transform">🔙</span>
            <div class="text-left">
                <p class="text-[9px] font-black uppercase tracking-[0.2em] leading-none opacity-60 mb-1">Testing Mode</p>
                <p class="text-xs font-black uppercase leading-tight">Exit Impersonation</p>
            </div>
        </button>
    </div>
}

@code {
    private bool hasBackdoor = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check for EITHER the backdoor cookie OR if the current user IS the demo/impersonated one
            var backdoor = await JS.InvokeAsync<string>("eval", @"
                (function() {
                    var name = 'ppp_admin_backdoor=';
                    var ca = document.cookie.split(';');
                    for(var i = 0; i < ca.length; i++) {
                        var c = ca[i].trim();
                        if (c.indexOf(name) == 0) return c.substring(name.length, c.length);
                    }
                    return null;
                })()");

            hasBackdoor = !string.IsNullOrEmpty(backdoor);
            if (hasBackdoor) StateHasChanged();
        }
    }

    private async Task RestoreAdmin()
    {
        // 1. Try to get the saved admin token
        var backdoorToken = await JS.InvokeAsync<string>("eval", @"
            (function() {
                var name = 'ppp_admin_backdoor=';
                var ca = document.cookie.split(';');
                for(var i = 0; i < ca.length; i++) {
                    var c = ca[i].trim();
                    if (c.indexOf(name) == 0) return c.substring(name.length, c.length);
                }
                return null;
            })()");

        // 2. If no backdoor token found, fallback to the hardcoded rescue token
        var tokenToRestore = !string.IsNullOrEmpty(backdoorToken) ? backdoorToken : "RESCUE_ADMIN_2026";

        // 3. NUCLEAR WIPE: Clear both cookies explicitly
        await JS.InvokeVoidAsync("eval", "document.cookie = 'ppp_token=; max-age=0; path=/;';");
        await JS.InvokeVoidAsync("eval", "document.cookie = 'ppp_admin_backdoor=; max-age=0; path=/;';");

        // 4. RE-INJECT ADMIN IDENTITY
        await JS.InvokeVoidAsync("eval", $"document.cookie = 'ppp_token={tokenToRestore}; max-age={60*60*24*180}; path=/; SameSite=Lax';");
        
        // 5. REDIRECT HOME
        await Task.Delay(200);
        Nav.NavigateTo("/ppp-dashboard", forceLoad: true);
    }
}