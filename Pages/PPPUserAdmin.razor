@page "/ppp-user-admin"
@using Dashboard
@using Dashboard.Components
@using Dashboard.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Diagnostics
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="min-h-screen bg-[#0a0a0a] text-white p-6 font-black relative overflow-hidden">
    
    <PPPAdminNav CurrentPage="User Registry" />

    @* TOAST NOTIFICATION STACK *@
    <div class="fixed top-24 right-6 z-[100] flex flex-col gap-3">
        @foreach (var toast in toasts)
        {
            <div class="p-4 rounded-2xl border shadow-2xl animate-in slide-in-from-right duration-300 @(toast.IsError ? "bg-red-950/90 border-red-500 text-red-200" : "bg-emerald-950/90 border-emerald-500 text-emerald-200")">
                <div class="flex items-center gap-3">
                    <span>@(toast.IsError ? "❌" : "✅")</span>
                    <span class="text-xs uppercase tracking-widest">@toast.Message</span>
                </div>
            </div>
        }
    </div>

    @* User Table Actions *@
    <div class="flex justify-end mb-6">
        <button @onclick="() => OpenModal()" class="bg-blue-600 hover:bg-blue-500 text-white px-6 py-2 rounded-xl text-[10px] uppercase tracking-widest transition shadow-lg">
            ＋ Add New User
        </button>
    </div>

    @* User Table *@
    <div class="bg-[#111] border border-gray-800 rounded-3xl overflow-hidden shadow-2xl">
        @if (isLoading)
        {
            <div class="py-20 flex flex-col items-center justify-center gap-4">
                <div class="w-12 h-12 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
                <div class="text-xs uppercase tracking-[0.4em] text-gray-600">Syncing_Records...</div>
            </div>
        }
        else
        {
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[10px] font-black uppercase text-gray-500 bg-gray-900/50 border-b border-gray-800">
                        <th class="p-5">User Profile</th>
                        <th class="p-5">Primary Location</th>
                        <th class="p-5">Role</th>
                        <th class="p-5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800/50">
                    @foreach (var user in users)
                    {
                        <tr class="hover:bg-white/5 transition group">
                            <td class="p-5">
                                <div class="flex items-center gap-3">
                                    @if (user.AvatarId.HasValue)
                                    {
                                        <img src="/db-images-ppp/@user.AvatarId" class="w-10 h-10 rounded-full object-cover border border-gray-700" />
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-gray-700 to-gray-900 border border-gray-700 flex items-center justify-center text-[10px] text-gray-400">
                                            @(string.IsNullOrEmpty(user.FirstName) ? "?" : user.FirstName[0])@(string.IsNullOrEmpty(user.LastName) ? "?" : user.LastName[0])
                                        </div>
                                    }
                                    <div>
                                        <div class="text-sm font-black uppercase tracking-tight text-white">@user.FirstName @user.LastName</div>
                                        <div class="text-[9px] text-gray-500 font-mono uppercase">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="p-5 font-mono text-[10px] text-gray-400">
                                @{
                                    var primaryAddr = user.Addresses?.FirstOrDefault(a => a.IsDefault) ?? user.Addresses?.FirstOrDefault();
                                }
                                @if (primaryAddr != null)
                                {
                                    <div class="text-slate-300 font-bold">@primaryAddr.Street</div>
                                    <div>@primaryAddr.City, @primaryAddr.State @primaryAddr.ZipCode</div>
                                }
                                else
                                {
                                    <span class="text-gray-700 italic">No Addresses</span>
                                }
                            </td>
                            <td class="p-5">
                                <span class="px-3 py-1 rounded text-[9px] font-black uppercase @GetRoleClass(user.Role)">
                                    @user.Role
                                </span>
                            </td>
                            <td class="p-5 text-right">
                                <div class="flex justify-end gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button @onclick="() => OpenModal(user)" class="p-2 text-blue-400 hover:bg-blue-500/10 rounded-lg transition" title="Edit">✎</button>
                                    <button @onclick="() => ConfirmDelete(user)" class="p-2 text-red-500 hover:bg-red-500/10 rounded-lg transition" title="Delete">✕</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@* EDIT/CREATE MODAL *@
@if (showModal)
{
    <div class="fixed inset-0 bg-black/90 backdrop-blur-sm z-[200] flex items-center justify-center p-4">
        <div class="bg-[#111] w-full max-w-4xl rounded-3xl border border-gray-800 shadow-[0_0_50px_rgba(0,0,0,0.8)] overflow-hidden animate-in zoom-in duration-200 flex flex-col max-h-[90vh]">
            <div class="p-6 bg-gray-900/50 border-b border-gray-800 flex justify-between items-center shrink-0">
                <h3 class="text-lg uppercase tracking-widest font-black text-blue-400">
                    @(editingUser.Id == 0 ? "Register New User" : "Update Profile")
                </h3>
                <button @onclick="CloseModal" class="text-gray-500 hover:text-white text-2xl font-light">&times;</button>
            </div>
            
            <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-10 overflow-y-auto">
                @* LEFT COLUMN: Account Details *@
                <div class="space-y-6">
                    <h4 class="text-[10px] uppercase tracking-[0.2em] text-blue-500 font-black mb-4">Account Security</h4>
                    
                    <div class="flex items-center gap-6 bg-black/30 p-4 rounded-2xl border border-gray-800">
                        @if (editingUser.AvatarId.HasValue)
                        {
                            <img src="/db-images-ppp/@editingUser.AvatarId" class="w-20 h-20 rounded-2xl object-cover border-2 border-blue-500/50" />
                        }
                        else
                        {
                            <div class="w-20 h-20 rounded-2xl bg-gray-900 border-2 border-dashed border-gray-700 flex items-center justify-center text-2xl">👤</div>
                        }
                        <div class="flex-1">
                            <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">Profile Image</label>
                            <InputFile OnChange="HandleImageUpload" class="text-xs text-gray-400 file:bg-blue-600 file:text-white file:border-0 file:px-3 file:py-1 file:rounded-lg file:mr-4 file:font-black file:uppercase file:text-[9px] cursor-pointer" />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">First Name</label>
                            <input @bind="editingUser.FirstName" class="w-full bg-black border border-gray-800 rounded-xl p-3 text-sm focus:border-blue-500 outline-none transition font-black uppercase" />
                        </div>
                        <div>
                            <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">Last Name</label>
                            <input @bind="editingUser.LastName" class="w-full bg-black border border-gray-800 rounded-xl p-3 text-sm focus:border-blue-500 outline-none transition font-black uppercase" />
                        </div>
                    </div>

                    <div>
                        <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">Email / Username</label>
                        <input @bind="editingUser.Email" class="w-full bg-black border border-gray-800 rounded-xl p-3 text-sm focus:border-blue-500 outline-none transition font-mono" />
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">Phone</label>
                            <input value="@editingUser.Phone" 
                                   @onchange="@(e => editingUser.Phone = PPPUtils.FormatPhoneNumber(e.Value?.ToString()))"
                                   placeholder="903-555-1212"
                                   class="w-full bg-black border border-gray-800 rounded-xl p-3 text-sm focus:border-blue-500 outline-none transition font-mono" />
                        </div>
                        <div>
                            <label class="text-[9px] uppercase text-gray-500 tracking-widest mb-2 block">Access Role</label>
                            <select @bind="editingUser.Role" class="w-full bg-black border border-gray-800 rounded-xl p-3 text-sm focus:border-blue-500 outline-none transition font-black uppercase">
                                <option value="Customer">Customer</option>
                                <option value="Staff">Staff</option>
                                <option value="Owner">Owner</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                    </div>
                </div>

                @* RIGHT COLUMN: Address Maintenance *@
                <div class="space-y-6">
                    <div class="flex justify-between items-end">
                        <h4 class="text-[10px] uppercase tracking-[0.2em] text-emerald-500 font-black">Address Registry</h4>
                        <button @onclick="AddNewAddress" class="text-[9px] font-black uppercase text-emerald-500 hover:text-white transition">＋ New Address</button>
                    </div>

                    <div class="space-y-4">
                        @if (editingUser.Addresses == null || !editingUser.Addresses.Any())
                        {
                            <div class="py-10 text-center border-2 border-dashed border-gray-800 rounded-3xl text-gray-600 uppercase text-[9px] font-black">
                                No physical addresses registered.
                            </div>
                        }
                        else
                        {
                            @foreach (var addr in editingUser.Addresses)
                            {
                                <div class="bg-black/30 border @(addr.IsDefault ? "border-emerald-500/50" : "border-gray-800") p-5 rounded-2xl relative group/addr transition-all">
                                    <div class="flex justify-between items-start mb-3">
                                        <div class="flex items-center gap-2">
                                            <input @bind="addr.Label" placeholder="Label (Home, Office...)" class="bg-transparent border-none text-[10px] font-black uppercase text-white outline-none focus:ring-0 p-0 w-32" />
                                            @if (addr.IsDefault)
                                            {
                                                <span class="bg-emerald-500 text-black text-[7px] px-1.5 py-0.5 rounded-full font-black">PRIMARY</span>
                                            }
                                        </div>
                                        <div class="flex items-center gap-2 opacity-0 group-hover/addr:opacity-100 transition-opacity">
                                            @if(!addr.IsDefault)
                                            {
                                                <button @onclick="() => SetPrimary(addr)" class="text-[8px] font-black text-gray-500 hover:text-emerald-500 uppercase">Set Primary</button>
                                            }
                                            <button @onclick="() => editingUser.Addresses.Remove(addr)" class="text-rose-500 text-xs">✕</button>
                                        </div>
                                    </div>

                                    <div class="space-y-2">
                                        <input @bind="addr.Street" placeholder="Street Address" class="w-full bg-black/50 border border-gray-800 rounded-lg p-2 text-xs text-slate-300 outline-none focus:border-blue-500" />
                                        <div class="grid grid-cols-3 gap-2">
                                            <input @bind="addr.City" placeholder="City" class="bg-black/50 border border-gray-800 rounded-lg p-2 text-xs text-slate-300 outline-none focus:border-blue-500" />
                                            <input @bind="addr.State" placeholder="ST" maxlength="2" class="bg-black/50 border border-gray-800 rounded-lg p-2 text-xs text-slate-300 outline-none focus:border-blue-500 text-center uppercase" />
                                            <input @bind="addr.ZipCode" placeholder="Zip" class="bg-black/50 border border-gray-800 rounded-lg p-2 text-xs text-slate-300 outline-none focus:border-blue-500 font-mono" />
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="p-6 bg-gray-900/50 border-t border-gray-800 flex justify-end gap-4 shrink-0">
                <button @onclick="CloseModal" class="text-[10px] text-gray-500 uppercase tracking-widest font-black px-6">Cancel</button>
                <button @onclick="SaveUser" class="bg-blue-600 hover:bg-blue-500 text-white text-[10px] uppercase tracking-widest font-black px-8 py-3 rounded-xl shadow-lg transition">
                    Commit Changes
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<PPP_User> users = new();
    private bool isLoading = true;
    private bool showModal = false;
    private PPP_User editingUser = new();
    private List<ToastItem> toasts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        try {
            users = await db.PPP_Users
                .Include(u => u.Addresses)
                .OrderBy(u => u.LastName)
                .ThenBy(u => u.FirstName)
                .ToListAsync();
        } catch (Exception ex) {
            _ = ShowToast("Load Error: " + ex.Message, true);
        } finally {
            isLoading = false;
        }
    }

    private string GetRoleClass(string role) => role switch {
        "Admin" => "bg-red-900/30 text-red-400 border border-red-800",
        "Owner" => "bg-purple-900/30 text-purple-400 border border-purple-800",
        "Staff" => "bg-emerald-900/30 text-emerald-400 border border-emerald-800",
        _ => "bg-blue-900/30 text-blue-400 border border-blue-800"
    };

    private void OpenModal(PPP_User? user = null)
    {
        if (user == null)
        {
            editingUser = new PPP_User { 
                CreatedAt = DateTime.UtcNow, 
                Role = "Customer",
                Addresses = new List<PPP_Address>()
            };
        }
        else
        {
            // Deep clone user and addresses for safe editing
            editingUser = new PPP_User
            {
                Id = user.Id,
                FirstName = user.FirstName,
                LastName = user.LastName,
                Email = user.Email,
                Phone = user.Phone,
                Role = user.Role,
                CreatedAt = user.CreatedAt,
                AvatarId = user.AvatarId,
                Addresses = user.Addresses.Select(a => new PPP_Address {
                    Id = a.Id,
                    Street = a.Street,
                    City = a.City,
                    State = a.State,
                    ZipCode = a.ZipCode,
                    Label = a.Label,
                    IsDefault = a.IsDefault,
                    UserId = a.UserId
                }).ToList()
            };
        }
        showModal = true;
    }

    private void AddNewAddress()
    {
        editingUser.Addresses.Add(new PPP_Address { 
            Label = "Home", 
            IsDefault = !editingUser.Addresses.Any(),
            UserId = editingUser.Id
        });
    }

    private void SetPrimary(PPP_Address target)
    {
        foreach(var a in editingUser.Addresses) a.IsDefault = false;
        target.IsDefault = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        try {
            var file = e.File;
            if (file == null) return;
            await using var db = await DbFactory.CreateDbContextAsync();

            using var ms = new System.IO.MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 2).CopyToAsync(ms);

            var newImage = new PPP_StoredImage
            {
                Data = ms.ToArray(),
                ContentType = file.ContentType,
                FileName = file.Name,
                UploadedAt = DateTime.UtcNow
            };

            db.PPP_StoredImages.Add(newImage);
            await db.SaveChangesAsync();
            
            editingUser.AvatarId = newImage.Id;
            _ = ShowToast("Avatar uploaded");
        }
        catch (Exception ex) {
            _ = ShowToast("Upload failed: " + ex.Message, true);
        }
    }

    private async Task SaveUser()
    {
        editingUser.Phone = PPPUtils.FormatPhoneNumber(editingUser.Phone);

        if (string.IsNullOrWhiteSpace(editingUser.FirstName) || string.IsNullOrWhiteSpace(editingUser.Email))
        {
            _ = ShowToast("Name and Email are required", true);
            return;
        }

        try {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            if (editingUser.Id == 0)
            {
                db.PPP_Users.Add(editingUser);
            }
            else
            {
                // Update basic user info
                var dbUser = await db.PPP_Users.Include(u => u.Addresses).FirstOrDefaultAsync(u => u.Id == editingUser.Id);
                if (dbUser == null) return;

                dbUser.FirstName = editingUser.FirstName;
                dbUser.LastName = editingUser.LastName;
                dbUser.Email = editingUser.Email;
                dbUser.Phone = editingUser.Phone;
                dbUser.Role = editingUser.Role;
                dbUser.AvatarId = editingUser.AvatarId;

                // Sync Addresses (Remove deleted ones, add new ones, update existing)
                var incomingIds = editingUser.Addresses.Select(a => a.Id).ToList();
                dbUser.Addresses.RemoveAll(a => !incomingIds.Contains(a.Id));

                foreach (var incoming in editingUser.Addresses)
                {
                    var existing = dbUser.Addresses.FirstOrDefault(a => a.Id == incoming.Id && a.Id != 0);
                    if (existing != null)
                    {
                        existing.Street = incoming.Street;
                        existing.City = incoming.City;
                        existing.State = incoming.State;
                        existing.ZipCode = incoming.ZipCode;
                        existing.Label = incoming.Label;
                        existing.IsDefault = incoming.IsDefault;
                    }
                    else
                    {
                        incoming.UserId = dbUser.Id;
                        dbUser.Addresses.Add(incoming);
                    }
                }
            }

            await db.SaveChangesAsync();
            await LoadUsers();
            _ = ShowToast("User record updated");
            CloseModal(); 
        } catch (Exception ex) {
            _ = ShowToast("Save Error: " + ex.Message, true);
        }
    }

    private async Task ConfirmDelete(PPP_User user)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Permanently remove {user.FirstName} {user.LastName}?"))
        {
            try {
                await using var db = await DbFactory.CreateDbContextAsync();
                var dbUser = await db.PPP_Users.FindAsync(user.Id);
                if (dbUser != null)
                {
                    db.PPP_Users.Remove(dbUser);
                    await db.SaveChangesAsync();
                    await LoadUsers();
                    _ = ShowToast("User deleted");
                }
            } catch (Exception ex) {
                _ = ShowToast("Delete Error: " + ex.Message, true);
            }
        }
    }

    private async Task ShowToast(string msg, bool isError = false)
    {
        var toast = new ToastItem { Message = msg, IsError = isError };
        toasts.Add(toast);
        StateHasChanged();
        await Task.Delay(4000);
        toasts.Remove(toast);
        StateHasChanged();
    }

    private class ToastItem { public string Message { get; set; } = ""; public bool IsError { get; set; } }
}