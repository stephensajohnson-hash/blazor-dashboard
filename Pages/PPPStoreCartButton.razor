@if (ItemCount > 0)
{
    <div class="fixed bottom-8 left-1/2 -translate-x-1/2 z-[150] w-full max-w-lg px-4">
        <button @onclick="HandleCartClick" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white p-6 rounded-[2rem] flex justify-between items-center shadow-2xl transition-all active:scale-95 border border-emerald-400/20">
            <div class="flex items-center gap-4">
                <span class="bg-white/20 px-3 py-1 rounded-lg font-black text-xs">@ItemCount</span>
                <span class="text-xs font-black uppercase tracking-widest">Review & Checkout</span>
            </div>
            <span class="font-mono font-bold">$@CartTotal.ToString("N2")</span>
        </button>
    </div>
}

@code {
    [Parameter] public int ItemCount { get; set; }
    [Parameter] public double CartTotal { get; set; }
    [Parameter] public EventCallback OnOpenCart { get; set; }

    private async Task HandleCartClick()
    {
        Console.WriteLine("[DEBUG] Cart Button Clicked");
        if (OnOpenCart.HasDelegate)
        {
            await OnOpenCart.InvokeAsync();
        }
    }
}